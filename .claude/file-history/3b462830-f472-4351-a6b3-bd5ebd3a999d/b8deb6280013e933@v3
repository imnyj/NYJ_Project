#!/usr/bin/env python3
"""Write the scheduled progress report for the main training run.

This runs from cron at 06, 12, 18 and 24, costs no model tokens, and produces one
Markdown file per report plus a rolling `latest.md`. The point of a scheduled
report is not to say "it is running" -- `ps` says that -- but to answer the
question a running job cannot answer for itself: is it running CORRECTLY, or is
it burning hours producing something that will have to be thrown away?

So each section is chosen to catch a specific silent failure this pipeline has
actually had:

  * episodes/hour and ETA          -> a run that has quietly stalled
  * zero-update episodes           -> the buffer never filling at low density,
                                      i.e. environment steps with no learning
  * gradient updates by density    -> the training mix skewing toward the dense
                                      end, which under-fits the sparse regime
  * reward trend over the last N   -> divergence, or a flat line meaning the
                                      policy stopped changing
  * NaN / non-finite scan          -> the failure that keeps running and poisons
                                      every later episode
  * checkpoint freshness           -> resume would lose everything since this
  * outage / AoI / error levels     -> metrics drifting outside plausible ranges

Usage:
    python report_progress.py                    # write a timestamped report
    python report_progress.py --stdout           # print instead of writing
"""
from __future__ import annotations

import argparse
import glob
import json
import math
import os
import sys
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional

import pandas as pd

CODER_DIR = "/home/imnyj/Workspace/paper4/coder"

# The report applies the SAME divergence rule the trainer applies live, by
# importing the same module. A run that finished before the guard existed leaves
# no status sidecar, so its progress CSV is replayed through the detector here;
# without that, the two PPO runs of 2026-09-02 keep reading as `done 100/100`
# forever, which is the failure this report is supposed to catch.
if CODER_DIR not in sys.path:
    sys.path.insert(0, CODER_DIR)
try:
    from src.divergence_guard import (  # noqa: E402
        STATUS_COMPLETED,
        scan_progress_rows,
    )
except Exception:  # pragma: no cover - report must still run without torch etc.
    STATUS_COMPLETED = "completed"
    scan_progress_rows = None  # type: ignore[assignment]

#: How an abort kind is shown in the state column.
ABORT_LABEL = {
    "diverged": "발산 중단",
    "grad_stall": "갱신 정체 중단",
    "trainer_crash": "학습 스레드 사망",
    "empty_episodes": "빈 에피소드 중단",
}
RUNS_DIR = os.path.join(CODER_DIR, "runs")
REPORT_DIR = "/home/imnyj/Workspace/paper4/review/training_reports"

# How many recent episodes the trend lines look at. Short enough to notice a
# change within one reporting interval, long enough not to read noise.
TREND_WINDOW = 10

# Plausibility bounds. Outside these the report says so rather than leaving the
# reader to eyeball a number whose normal range they may not remember.
PLAUSIBLE = {
    "mean_aoi": (0.0, 60.0),
    "coverage_outage_rate": (0.0, 0.75),
    "mean_error": (0.0, 200.0),
}


def _fmt(x: Any, nd: int = 4) -> str:
    if x is None:
        return "n/a"
    if isinstance(x, float):
        if math.isnan(x) or math.isinf(x):
            return f"**{x}**"
        return f"{x:.{nd}f}"
    return str(x)


def _age(path: str) -> Optional[float]:
    try:
        return (datetime.now().timestamp() - os.path.getmtime(path)) / 60.0
    except OSError:
        return None


def _failed_models(run_dir: str) -> set:
    """Models whose training raised, read from the supervisor's captured stdout.

    `run_all.py` logs `Failed training <name>: ...` and keeps going with the next
    model, so a single failure does not stop the run and leaves no other trace a
    report can see.
    """
    failed = set()
    log = os.path.join(run_dir, "sup", "train.log")
    if not os.path.isfile(log):
        return failed
    try:
        with open(log, errors="replace") as fh:
            for line in fh:
                if "Failed training" in line:
                    parts = line.split("Failed training", 1)[1].strip().split(":", 1)
                    if parts and parts[0].strip():
                        failed.add(parts[0].strip())
    except OSError:
        pass
    return failed


def scan_run(run_dir: str) -> Dict[str, Any]:
    """Summarise one (arm, seed) run directory."""
    name = os.path.basename(run_dir.rstrip("/"))
    out: Dict[str, Any] = {"name": name, "models": [], "problems": []}

    cfg_path = os.path.join(run_dir, "run_config.json")
    if os.path.isfile(cfg_path):
        try:
            out["config"] = json.load(open(cfg_path))
        except Exception:
            out["config"] = None

    res_path = os.path.join(run_dir, "run_result.json")
    if os.path.isfile(res_path):
        try:
            out["result"] = json.load(open(res_path))
        except Exception:
            out["result"] = None

    target_eps = int((out.get("config") or {}).get("episodes") or 100)

    # Which models to report on comes from the CHECKPOINT directory as well as the
    # log directory. Driving the report off `lg/*.csv` alone made a running job
    # invisible: a model mid-training has checkpoints but its progress rows may
    # not have appeared yet, so the report showed "0/0 episodes" and omitted the
    # row entirely -- "training now", "failed after 20 retries" and "never
    # started" all looked identical. A report that cannot tell those apart is
    # worse than none, because it reads as reassurance.
    models = set()
    for c in glob.glob(os.path.join(run_dir, "lg", "*_progress.csv")):
        models.add(os.path.basename(c).replace("_progress.csv", ""))
    for c in glob.glob(os.path.join(run_dir, "ck", "*_ep*.pt")):
        base = os.path.basename(c)
        models.add(base[:base.rindex("_ep")])

    failed_models = _failed_models(run_dir)

    for model in sorted(models):
        csv_path = os.path.join(run_dir, "lg", f"{model}_progress.csv")
        df = pd.DataFrame()
        if os.path.isfile(csv_path):
            try:
                df = pd.read_csv(csv_path)
            except Exception as exc:
                out["problems"].append(f"{model}: progress CSV unreadable ({exc})")

        rec: Dict[str, Any] = {"model": model, "episodes_done": int(len(df)),
                               "target_episodes": target_eps}

        # Progress falls back to the checkpoint numbering when no rows exist yet,
        # so a model that is training right now reports its real position.
        cks = glob.glob(os.path.join(run_dir, "ck", f"{model}_ep*.pt"))
        ck_eps = []
        for c in cks:
            b = os.path.basename(c)
            try:
                ck_eps.append(int(b[b.rindex("_ep") + 3:-3]))
            except ValueError:
                pass
        if ck_eps and max(ck_eps) > rec["episodes_done"]:
            rec["episodes_done"] = max(ck_eps)
            rec["progress_from"] = "checkpoint"

        # Freshness is judged on the checkpoint, not the CSV. A model that has
        # finished leaves a CSV that ages forever and would otherwise be reported
        # as stalled every time, while a model that actually froze mid-episode
        # would not be reported at all.
        newest_ck = max(cks, key=os.path.getmtime) if cks else None
        age_min = _age(newest_ck) if newest_ck else _age(csv_path)
        rec["age_min"] = age_min

        # ------------------------------------------------------------------
        # Was this run stopped because it stopped learning? Two sources, in
        # order of authority:
        #
        #   1. `lg/{model}_status.json`, written by run_hot_swap_training when
        #      it aborts. Authoritative: it carries the verdict the trainer
        #      itself reached, with the reason.
        #   2. The progress CSV replayed through the same detector. Covers runs
        #      that finished before the guard existed, and a run killed so hard
        #      that no sidecar was written.
        #
        # This is checked BEFORE `episodes_done >= target_eps`, because the
        # 2026-09-02 PPO runs did reach 100 rows and were shown as `done`.
        # ------------------------------------------------------------------
        abort_kind: Optional[str] = None
        abort_note = ""
        status_path = os.path.join(run_dir, "lg", f"{model}_status.json")
        if os.path.isfile(status_path):
            try:
                status = json.load(open(status_path))
            except Exception as exc:
                out["problems"].append(f"{model}: status sidecar unreadable ({exc})")
            else:
                rec["status_source"] = "sidecar"
                st = str(status.get("status", "")).strip()
                if st and st != STATUS_COMPLETED:
                    abort_kind = st
                    abort_note = str(status.get("abort_reason") or "")
                    rec["abort_episode"] = status.get("abort_episode")
        if abort_kind is None and scan_progress_rows is not None and not df.empty:
            try:
                verdict = scan_progress_rows(df.to_dict("records"))
            except Exception as exc:
                out["problems"].append(f"{model}: divergence scan failed ({exc})")
            else:
                if verdict is not None:
                    abort_kind = verdict.kind
                    abort_note = verdict.reason
                    rec["abort_episode"] = verdict.episode
                    rec["status_source"] = "csv-scan"

        if abort_kind:
            rec["abort_kind"] = abort_kind
            label = ABORT_LABEL.get(abort_kind, abort_kind)
            # A CSV-derived verdict is a reading of a finished file, not a
            # decision the run itself took, so the state says which it is.
            if rec.get("status_source") == "csv-scan":
                rec["state"] = f"{label}(추정)"
            else:
                rec["state"] = label
            out["problems"].append(
                f"{model}: {label} — 에피소드 {rec.get('abort_episode')}에서 "
                f"학습이 중단되었다. {abort_note}")
        elif model in failed_models:
            rec["state"] = "failed"
            out["problems"].append(f"{model}: training reported a failure in train.log")
        elif rec["episodes_done"] >= target_eps:
            rec["state"] = "done"
        elif rec["episodes_done"] == 0:
            rec["state"] = "not started"
        elif age_min is not None and age_min > 30:
            rec["state"] = "STALLED?"
            out["problems"].append(
                f"{model}: no new checkpoint for {age_min:.0f} min at episode "
                f"{rec['episodes_done']}/{target_eps} -- possible stall")
        else:
            rec["state"] = "training"

        if df.empty:
            out["models"].append(rec)
            continue

        # Gaps in the episode numbering mean history was lost, which used to
        # happen on every SIGKILL before the progress CSV was written per episode.
        if "episode" in df.columns and len(df):
            eps = sorted(int(e) for e in pd.to_numeric(df["episode"], errors="coerce").dropna())
            if eps:
                missing = sorted(set(range(1, max(eps) + 1)) - set(eps))
                if missing:
                    rec["missing_episodes"] = len(missing)
                    out["problems"].append(
                        f"{model}: {len(missing)} episode row(s) missing from the history "
                        f"(first gap at {missing[0]})")

        for col, key in (("reward_per_sec_selected", "reward_per_sec"),
                         ("mean_reward", "mean_reward"),
                         ("mean_loss", "mean_loss"),
                         ("mean_aoi", "mean_aoi"),
                         ("mean_error", "mean_error"),
                         ("coverage_outage_rate", "coverage_outage_rate")):
            if col in df.columns:
                tail = pd.to_numeric(df[col], errors="coerce").tail(TREND_WINDOW)
                rec[key] = float(tail.mean()) if len(tail) else None
                if len(tail) >= 2:
                    first, last = tail.iloc[0], tail.iloc[-1]
                    rec[key + "_delta"] = (float(last - first)
                                           if pd.notna(first) and pd.notna(last) else None)

        # Non-finite values anywhere are the failure that keeps running.
        num = df.select_dtypes("number")
        bad = int((~num.map(lambda v: math.isfinite(v) if isinstance(v, float) else True)).sum().sum()) \
            if not num.empty else 0
        rec["nonfinite_cells"] = bad
        if bad:
            out["problems"].append(f"{model}: {bad} non-finite value(s) in progress CSV")

        if "grad_updates_this_episode" in df.columns:
            gu = pd.to_numeric(df["grad_updates_this_episode"], errors="coerce")
            rec["zero_update_episodes"] = int((gu.fillna(0) <= 0).sum())
            rec["grad_updates_total"] = int(gu.fillna(0).sum())
            if rec["zero_update_episodes"]:
                out["problems"].append(
                    f"{model}: {rec['zero_update_episodes']} episode(s) with no gradient update")
        if {"density", "grad_updates_this_episode"} <= set(df.columns):
            by = df.groupby("density")["grad_updates_this_episode"].sum()
            rec["updates_by_density"] = {float(k): int(v) for k, v in by.items()}
            lo, hi = by.min(), by.max()
            if lo > 0:
                rec["update_skew"] = float(hi / lo)

        for key, (lo, hi) in PLAUSIBLE.items():
            val = rec.get(key)
            if val is not None and not (lo <= val <= hi):
                out["problems"].append(
                    f"{model}: {key} = {val:.4f} outside the plausible range [{lo}, {hi}]")

        cks = glob.glob(os.path.join(run_dir, "ck", f"{model}_ep*.pt"))
        rec["checkpoints"] = len(cks)
        if cks:
            newest = max(cks, key=os.path.getmtime)
            rec["newest_checkpoint"] = os.path.basename(newest)
            rec["checkpoint_age_min"] = _age(newest)

        out["models"].append(rec)

    return out


def render(runs: List[Dict[str, Any]], now: datetime) -> str:
    L: List[str] = []
    A = L.append
    A(f"# 훈련 진행 보고 ({now.strftime('%Y-%m-%d %H:%M')})")
    A("")
    if not runs:
        A("`coder/runs/` 아래에 실행 디렉터리가 없다. 본훈련이 아직 시작되지 않았거나 "
          "다른 경로로 실행 중이다.")
        return "\n".join(L)

    all_problems = [(r["name"], p) for r in runs for p in r["problems"]]
    A("## 요약")
    A("")
    if all_problems:
        A(f"확인이 필요한 항목 {len(all_problems)}건이 있다. 아래 이상 징후 절을 볼 것.")
    else:
        A("이상 징후로 잡힌 것은 없다. 아래 수치는 정상 범위 안에 있다.")
    A("")

    A("| 실행 | 모델 | 상태 | 에피소드 | 갱신 0회 | 체크포인트 | 최신 갱신(분) |")
    A("|---|---|---|---:|---:|---:|---:|")
    for r in runs:
        for m in r["models"]:
            src = " (ck)" if m.get("progress_from") == "checkpoint" else ""
            A(f"| {r['name']} | {m['model']} | {m.get('state', '?')} | "
              f"{m['episodes_done']}/{m['target_episodes']}{src} | "
              f"{m.get('zero_update_episodes', 0)} | {m.get('checkpoints', 0)} | "
              f"{_fmt(m.get('age_min'), 1)} |")
    A("")

    if all_problems:
        A("## 이상 징후")
        A("")
        for run_name, p in all_problems:
            A(f"- `{run_name}` {p}")
        A("")

    A("## 학습 추이")
    A("")
    A(f"최근 {TREND_WINDOW} 에피소드 평균과, 그 구간의 시작 대비 변화량이다. "
      "보상은 항상 0 이하이므로 변화량이 양수면 개선이다.")
    A("")
    A("| 실행 | 모델 | 초당 보상 | 변화 | 손실 | AoI | 추정오차 | 아웃티지 |")
    A("|---|---|---:|---:|---:|---:|---:|---:|")
    for r in runs:
        for m in r["models"]:
            A(f"| {r['name']} | {m['model']} | {_fmt(m.get('reward_per_sec'))} | "
              f"{_fmt(m.get('reward_per_sec_delta'))} | {_fmt(m.get('mean_loss'))} | "
              f"{_fmt(m.get('mean_aoi'), 3)} | {_fmt(m.get('mean_error'), 3)} | "
              f"{_fmt(m.get('coverage_outage_rate'), 3)} |")
    A("")

    A("## 밀도별 학습량")
    A("")
    A("훈련 데이터 혼합이 한쪽 밀도로 기울면 반대쪽 영역을 과소적합한다. "
      "편차(최대/최소)가 크게 벌어지면 `--updates-per-env-step`을 고려할 것.")
    A("")
    for r in runs:
        for m in r["models"]:
            ubd = m.get("updates_by_density")
            if not ubd:
                continue
            cells = " ".join(f"{int(k)}:{v}" for k, v in sorted(ubd.items()))
            A(f"- `{r['name']}` **{m['model']}** 편차 {_fmt(m.get('update_skew'), 1)}배 — {cells}")
    A("")

    A("## 완료 상태")
    A("")
    for r in runs:
        res = r.get("result")
        if res:
            verdict = "정상 종료" if res.get("exit_code") == 0 else f"실패 (rc={res.get('exit_code')})"
            A(f"- `{r['name']}` {verdict}, 시도 {res.get('attempts')}회, {res.get('finished')}")
        else:
            done = sum(m["episodes_done"] for m in r["models"])
            tgt = sum(m["target_episodes"] for m in r["models"])
            pct = (100.0 * done / tgt) if tgt else 0.0
            A(f"- `{r['name']}` 진행 중, 전체 {done}/{tgt} 에피소드 ({pct:.1f}%)")
    A("")
    A("---")
    A("")
    A("이 보고서는 `coder/etc/report_progress.py`가 cron으로 생성한다. "
      "생성에 모델 토큰이 들지 않는다.")
    return "\n".join(L)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--stdout", action="store_true", help="print instead of writing files")
    args = ap.parse_args()

    now = datetime.now()
    runs = []
    if os.path.isdir(RUNS_DIR):
        for d in sorted(glob.glob(os.path.join(RUNS_DIR, "*"))):
            if os.path.isdir(d):
                runs.append(scan_run(d))

    text = render(runs, now)

    if args.stdout:
        print(text)
        return 0

    os.makedirs(REPORT_DIR, exist_ok=True)
    stamped = os.path.join(REPORT_DIR, f"report_{now.strftime('%Y%m%d_%H%M')}.md")
    with open(stamped, "w") as fh:
        fh.write(text + "\n")
    with open(os.path.join(REPORT_DIR, "latest.md"), "w") as fh:
        fh.write(text + "\n")
    print(f"wrote {stamped}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
