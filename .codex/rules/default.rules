prefix_rule(pattern=["perl", "-e", "my ($pending,$path,$capture,$buf,$checked,$mismatch) = (q{},q{},0,q{},0,0); open my $fh, q{<}, q{/home/imnyj/antigravity_upgrades.md} or die $!; while (my $line = <$fh>) { if ($line =~ /^#### 파일 생성: `~([^`]+)`/) { $pending = q{/home/imnyj} . $1; next; } if ($pending ne q{} && !$capture && $line =~ /^```markdown\\s*$/) { $path=$pending; $pending=q{}; $capture=1; $buf=q{}; next; } if ($capture && $line =~ /^```\\s*$/) { $checked++; open my $afh, q{<}, $path or die \"missing $path\\n\"; local $/; my $actual=<$afh>; close $afh; if ($actual ne $buf) { print \"CONTENT_MISMATCH $path\\n\"; $mismatch++; } $capture=0; next; } $buf .= $line if $capture; } print \"checked=$checked content_mismatches=$mismatch\\n\"; exit($mismatch ? 1 : 0);"], decision="allow")
prefix_rule(pattern=["perl", "-e", "my ($pending,$path,$capture,$buf) = (q{},q{},0,q{}); open my $fh, q{<}, q{/home/imnyj/antigravity_upgrades.md} or die $!; while (my $line = <$fh>) { if ($line =~ /^#### 파일 생성: `~([^`]+)`/) { $pending = q{/home/imnyj} . $1; next; } if ($pending ne q{} && !$capture && $line =~ /^```markdown\\s*$/) { $path=$pending; $pending=q{}; $capture=1; $buf=q{}; next; } if ($capture && $line =~ /^```\\s*$/) { if ($path eq q{/home/imnyj/.agents/skills/academic-worker/SKILL.md}) { open my $out, q{>}, q{/tmp/expected-skill.md} or die $!; print {$out} $buf; close $out; } $capture=0; next; } $buf .= $line if $capture; }"], decision="allow")
