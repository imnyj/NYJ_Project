    """기본 테스트용 100일 일봉 주가 데이터"""
    dates = pd.bdate_range(start="2024-01-02", periods=100)
    prices = []
    base_p = 70000.0
    for i, dt in enumerate(dates):
        close_p = base_p + (i * 150.0) + (100.0 if i % 2 == 0 else -100.0)
        prices.append({
            "date": dt,
            "symbol": "005930",
            "open": close_p - 200.0,
            "high": close_p + 500.0,
            "low": close_p - 400.0,
            "close": close_p,
            "volume": 1000000 + i * 5000,
            "value": float(close_p * (1000000 + i * 5000)),
            "timeframe": "1d",
            "adj_factor": 1.0,
            "is_trading_halt": False
        })
    return pd.DataFrame(prices)


