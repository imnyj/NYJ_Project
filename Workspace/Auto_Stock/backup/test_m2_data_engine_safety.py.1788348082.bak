class TestPipelineSafety:
    """통합 파이프라인 리소스 관리 테스트"""

    def test_pipeline_context_manager(self):
        """DataCollectionPipeline Context Manager 정상 진입 및 해제 검증"""
        with DataCollectionPipeline() as pipeline:
            assert pipeline.fundamental_collector is not None
            assert pipeline.price_collector is not None
            assert pipeline.consolidator is not None
