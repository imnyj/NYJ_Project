# M3 Consolidator & Pipeline 임포트 (있을 경우 임포트, 없을 경우 내장 구현체 제공)
try:
    from modules.data.consolidator import DataConsolidator
except ImportError:
    class DataConsolidator:
        """
        Look-ahead bias 방지 Point-in-Time(PIT) 데이터 병합 및 Parquet 저장기
        """
        @staticmethod
        def consolidate_point_in_time(
            price_df: pd.DataFrame,
            fundamental_df: pd.DataFrame,
            symbol: Optional[str] = None
        ) -> pd.DataFrame:
            if price_df.empty:
                return pd.DataFrame()

            p_df = price_df.copy()
            if not pd.api.types.is_datetime64_any_dtype(p_df['date']):
                p_df['date'] = pd.to_datetime(p_df['date'])
            p_df = p_df.sort_values('date').reset_index(drop=True)

            if fundamental_df.empty:
                p_df['dynamic_per'] = np.nan
                p_df['dynamic_pbr'] = np.nan
                p_df['returns_1d'] = p_df['close'].pct_change().fillna(0.0)
                p_df['is_cross_verified'] = False
                p_df['warning_flags'] = 'NO_FUNDAMENTAL_DATA'
                return p_df

            f_df = fundamental_df.copy()
            if not pd.api.types.is_datetime64_any_dtype(f_df['announcement_date']):
                f_df['announcement_date'] = pd.to_datetime(f_df['announcement_date'])
            f_df = f_df.sort_values('announcement_date').reset_index(drop=True)

            # Look-ahead Bias 방지: pd.merge_asof(direction='backward')
            # 거래일(t) 시점에 합법적으로 공시되어 있던 가장 최신의 펀더멘털 데이터 매핑
            merged = pd.merge_asof(
                p_df,
                f_df,
                left_on='date',
                right_on='announcement_date',
                direction='backward',
                suffixes=('', '_fund')
            )

            # 동적 밸류에이션 피처 및 파생 지표 산출
            # 1. Dynamic PER = Close / EPS (EPS <= 0 이면 NaN 마스킹)
            if 'eps' in merged.columns:
                valid_eps = merged['eps'].apply(lambda x: x if (pd.notna(x) and x > 0) else np.nan)
                merged['dynamic_per'] = merged['close'] / valid_eps
            else:
                merged['dynamic_per'] = np.nan

            # 2. Dynamic PBR = Close / BPS
            if 'bps' in merged.columns:
                valid_bps = merged['bps'].apply(lambda x: x if (pd.notna(x) and x > 0) else np.nan)
                merged['dynamic_pbr'] = merged['close'] / valid_bps
            else:
                merged['dynamic_pbr'] = np.nan

            # 3. Dynamic Market Cap = Close * Shares Outstanding
            if 'shares_outstanding' in merged.columns and merged['shares_outstanding'].notna().any():
                merged['dynamic_market_cap'] = merged['close'] * merged['shares_outstanding']
            elif 'equity' in merged.columns and 'bps' in merged.columns:
                calc_shares = merged['equity'] / merged['bps'].replace(0, np.nan)
                merged['dynamic_market_cap'] = merged['close'] * calc_shares
            else:
                merged['dynamic_market_cap'] = np.nan

            # 4. 1일 수익률 및 20일 역사적 변동성
            merged['returns_1d'] = merged['close'].pct_change().fillna(0.0)
            merged['volatility_20d'] = merged['returns_1d'].rolling(20, min_periods=1).std().fillna(0.0) * np.sqrt(252)

            # 5. 이동평균선
            merged['ma_5'] = merged['close'].rolling(5, min_periods=1).mean()
            merged['ma_20'] = merged['close'].rolling(20, min_periods=1).mean()
            merged['ma_60'] = merged['close'].rolling(60, min_periods=1).mean()

            # 6. 교차 검증 상태 플래그
            if 'validation_status' in merged.columns:
                merged['is_cross_verified'] = merged['validation_status'].isin(
                    [ValidationStatus.PASSED.value, ValidationStatus.WARNING.value, 'PASSED', 'WARNING']
                )
            else:
                merged['is_cross_verified'] = True

            # 7. 경고 플래그 조립
            warning_list = []
            min_announce = f_df['announcement_date'].min()
            for idx, row in merged.iterrows():
                flags = []
                if pd.isna(row.get('announcement_date')) or row['date'] < min_announce:
                    flags.append('PRE_ANNOUNCEMENT_PERIOD')
                if pd.notna(row.get('eps')) and row['eps'] <= 0:
                    flags.append('NEGATIVE_EPS')
                if pd.notna(row.get('operating_income')) and row['operating_income'] < 0:
                    flags.append('OPERATING_LOSS')
                if row.get('is_trading_halt', False):
                    flags.append('TRADING_HALT')
                warning_list.append('|'.join(flags) if flags else 'NORMAL')
            merged['warning_flags'] = warning_list

            return merged

        @staticmethod
        def save_to_parquet(
            df: pd.DataFrame,
            filepath: Optional[Union[str, pathlib.Path]] = None,
            compression: str = 'ZSTD'
        ) -> pathlib.Path:
            if filepath is None:
                symbol = df['symbol'].iloc[0] if ('symbol' in df.columns and not df.empty) else 'UNKNOWN'
                target_dir = pathlib.Path(PROJECT_ROOT) / "data" / "raw"
                target_dir.mkdir(parents=True, exist_ok=True)
                filepath = target_dir / f"{symbol}_consolidated.parquet"
            else:
                filepath = pathlib.Path(filepath)
                filepath.parent.mkdir(parents=True, exist_ok=True)

            df.to_parquet(filepath, engine='pyarrow', compression=compression, index=False)
            return filepath

        @staticmethod
        def load_from_parquet(filepath: Union[str, pathlib.Path]) -> pd.DataFrame:
            return pd.read_parquet(filepath, engine='pyarrow')

try:
    from modules.data.pipeline import DataPipeline
except ImportError:
    class DataPipeline:
        """
        Phase 1 통합 데이터 파이프라인 Facade:
        Fundamental 수집/검증 -> Price 수집 -> PIT 병합 -> Parquet 저장 일괄 실행
        """
        def __init__(
            self,
            fundamental_collector: Optional[FundamentalDataCollector] = None,
            price_collector: Optional[PriceDataCollector] = None,
            consolidator: Optional[DataConsolidator] = None
        ):
            self.fundamental_collector = fundamental_collector or FundamentalDataCollector()
            self.price_collector = price_collector or PriceDataCollector()
            self.consolidator = consolidator or DataConsolidator()

        def run_pipeline(
            self,
            symbol: str,
            count: int = 500,
            start_date: Optional[str] = None,
            end_date: Optional[str] = None,
            period_type: PeriodType = PeriodType.ANNUAL,
            save_raw: bool = True,
            output_filepath: Optional[str] = None
        ) -> Tuple[pd.DataFrame, Dict[str, Any]]:
            # 1. 펀더멘털 데이터 수집 및 교차 검증
            fund_df = self.fundamental_collector.get_as_dataframe(
                ticker=symbol, period_type=period_type
            )
            _, val_report = self.fundamental_collector.get_financial_statements(
                ticker=symbol, period_type=period_type
            )

            # 2. 가격 시계열 데이터 수집
            price_df = self.price_collector.get_daily_ohlcv(
                symbol=symbol,
                count=count,
                start_date=start_date,
                end_date=end_date
            )

            # 3. Point-in-Time 통합 병합
            consolidated_df = self.consolidator.consolidate_point_in_time(
                price_df=price_df,
                fundamental_df=fund_df,
                symbol=symbol
            )

            # 4. Parquet 저장
            saved_path = None
            if save_raw and not consolidated_df.empty:
                saved_path = str(self.consolidator.save_to_parquet(consolidated_df, filepath=output_filepath))

            metadata = {
                "symbol": symbol,
                "row_count": len(consolidated_df),
                "saved_path": saved_path,
                "validation_status": val_report.status.value if val_report else "SINGLE_SOURCE",
                "max_discrepancy_pct": val_report.max_discrepancy_pct if val_report else 0.0,
                "executed_at": datetime.now().isoformat()
            }
            return consolidated_df, metadata


