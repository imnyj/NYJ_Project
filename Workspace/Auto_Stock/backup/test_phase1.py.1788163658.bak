    def test_tier4_parquet_partitioned_raw_directory_integrity(self):
        """data/raw/ 디렉토리 구조 및 Parquet 파일 메타데이터 무결성 검증"""
        raw_dir = pathlib.Path(PROJECT_ROOT) / "data" / "raw"
        raw_dir.mkdir(parents=True, exist_ok=True)
        test_file = raw_dir / "sample_check.parquet"

        df_sample = pd.DataFrame({
            "date": [pd.to_datetime("2026-08-31")],
            "symbol": ["005930"],
            "open": [70000.0],
            "high": [71000.0],
            "low": [69500.0],
            "close": [70500.0],
            "volume": [100000],
            "is_cross_verified": [True],
            "warning_flags": ["NORMAL"]
        })
        DataConsolidator.save_to_parquet(df_sample, filepath=test_file, compression='ZSTD')

        # PyArrow로 직접 메타데이터 검증
        parquet_file = pq.ParquetFile(test_file)
        schema = parquet_file.schema_arrow
        assert "date" in schema.names
        assert "symbol" in schema.names
        assert "close" in schema.names
        assert parquet_file.metadata.num_rows == 1
