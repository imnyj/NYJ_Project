# TIER 1: Functional Unit Tests (기능 단위 검증)
# =====================================================================

class TestTier1FunctionalUnits:
    """
    Tier 1: 각 컴포넌트(수집기, 검증기, 스트리머, 병합기, 스토리지)의 단독 정상 기능 검증
    """

    def test_tier1_fundamental_opendart_collector_metadata(self):
        """DART 수집기 고유코드 캐시 및 계정명 동의어 사전 무결성 확인"""
        dart = OpenDartCollector(api_key="TEST_KEY")
        assert dart.get_corp_code("005930") == "00126380"
        assert dart.get_corp_code("000660") == "00164779"
        assert "매출액" in dart.ACCOUNT_SYNONYMS["revenue"]
        assert "영업이익" in dart.ACCOUNT_SYNONYMS["operating_profit"]

    def test_tier1_fundamental_naver_collector_unit_normalization(self):
        """NaverFinanceCollector의 억원 -> 원 변환 정규화 검증"""
        naver = NaverFinanceCollector()
        mock_data = {
            "financeInfo": {
                "trTitleList": [{"key": "202412", "title": "2024.12.", "isConsensus": "N"}],
                "rowList": [
                    {"title": "매출액", "columns": {"202412": {"value": "300,870"}}},
                    {"title": "영업이익", "columns": {"202412": {"value": "32,726"}}},
                    {"title": "당기순이익", "columns": {"202412": {"value": "34,451"}}},
                    {"title": "ROE", "columns": {"202412": {"value": "9.4"}}},
                    {"title": "PER", "columns": {"202412": {"value": "15.2"}}},
                    {"title": "PBR", "columns": {"202412": {"value": "1.6"}}},
                    {"title": "EPS", "columns": {"202412": {"value": "4,800"}}},
                    {"title": "BPS", "columns": {"202412": {"value": "55,000"}}},
                ]
            }
        }
        stmts = naver._parse_table_json("005930", mock_data, PeriodType.ANNUAL)
        assert len(stmts) == 1
        s = stmts[0]
        assert s.revenue == 30_087_000_000_000
        assert s.operating_profit == 3_272_600_000_000
        assert s.net_income == 3_445_100_000_000
        assert s.eps == 4800.0
        assert s.bps == 55000.0

    def test_tier1_fundamental_mock_kiwoom_data_generation(self):
        """MockKiwoomCollector의 고충실도 모의 재무제표 및 가치평가 생성 검증"""
        mock_k = MockKiwoomCollector()
        annuals = mock_k.get_annual_financials("005930", 2021, 2024)
        assert len(annuals) >= 4
        assert all(s.revenue > 0 for s in annuals)
        assert all(s.operating_profit > 0 for s in annuals)

        realtime = mock_k.get_realtime_valuation("005930")
        assert realtime is not None
        assert realtime.current_price > 0
        assert realtime.market_cap > 0
        assert realtime.shares_outstanding == 5_969_782_550

    def test_tier1_cross_validator_relative_discrepancy(self):
        """FundamentalCrossValidator의 상대 오차율 공식 계산 검증"""
        # 완전 일치 -> 0%
        assert FundamentalCrossValidator.calculate_discrepancy(10000, 10000) == 0.0
        # 100 vs 95 -> 5.0%
        diff_5 = FundamentalCrossValidator.calculate_discrepancy(100, 95)
        assert abs(diff_5 - 5.0) < 1e-3
        # 100 vs 90 -> 10.0%
        diff_10 = FundamentalCrossValidator.calculate_discrepancy(100, 90)
        assert abs(diff_10 - 10.0) < 1e-3

    def test_tier1_fundamental_data_collector_dataframe_schema(self):
        """FundamentalDataCollector get_as_dataframe()의 Interface Contract 18개 컬럼 충족 검증"""
        collector = FundamentalDataCollector(mock_mode=True)
        df = collector.get_as_dataframe("005930", PeriodType.ANNUAL, 2021, 2024)
        
        expected_cols = [
            'symbol', 'period_end', 'announcement_date', 'revenue', 'operating_income',
            'net_income', 'assets', 'liabilities', 'equity', 'per', 'pbr', 'roe',
            'eps', 'bps', 'div_yield', 'is_consensus', 'source', 'validation_status'
        ]
        for col in expected_cols:
            assert col in df.columns, f"Missing expected interface contract column: {col}"
        assert pd.api.types.is_datetime64_any_dtype(df['period_end'])
        assert pd.api.types.is_datetime64_any_dtype(df['announcement_date'])

    def test_tier1_price_collector_daily_ohlcv(self):
        """PriceDataCollector의 일봉 OHLCV 수집 및 표준 컬럼 검증"""
        fetcher = MockPriceFetcher(base_price=70000.0, seed=123)
        collector = PriceDataCollector(fetchers=[fetcher])
        df = collector.get_daily_ohlcv("005930", count=50)

        assert not df.empty
        assert len(df) == 50
        for col in ['date', 'symbol', 'open', 'high', 'low', 'close', 'volume', 'timeframe']:
            assert col in df.columns
        assert df['timeframe'].iloc[0] == '1d'

    def test_tier1_price_minute_resampling_integrity(self):
        """1분봉 데이터의 5분/15분 리샘플링 산술적 무결성 (O=first, H=max, L=min, C=last, V=sum) 검증"""
        fetcher = MockPriceFetcher(base_price=70000.0, seed=42)
        df_1m = fetcher.fetch_minute("005930", date="2026-08-31", timeframe="1m")
        assert len(df_1m) > 0

        df_5m = PriceDataCollector.resample_ohlcv(df_1m, target_timeframe='5m')
        assert not df_5m.empty
        # 첫 5개 1분봉과 첫 5분봉 비교
        first_5_1m = df_1m.iloc[:5]
        first_5m = df_5m.iloc[0]
        assert first_5m['open'] == first_5_1m['open'].iloc[0]
        assert first_5m['high'] == first_5_1m['high'].max()
        assert first_5m['low'] == first_5_1m['low'].min()
        assert first_5m['close'] == first_5_1m['close'].iloc[-1]
        assert first_5m['volume'] == first_5_1m['volume'].sum()

    def test_tier1_streamer_ringbuffer_operations(self):
        """RealtimeRingBuffer의 append, get_recent_ticks, to_dataframe 기본 기능 검증"""
        buf = RealtimeRingBuffer(capacity_per_symbol=100)
        now = datetime.now()
        for i in range(10):
            tick = TickData(
                timestamp=now + timedelta(seconds=i),
                symbol="005930",
                price=70000.0 + i * 100,
                volume=10,
                accum_volume=(i + 1) * 10
            )
            buf.append(tick)

        assert buf.size("005930") == 10
        latest = buf.get_latest_tick("005930")
        assert latest is not None
        assert latest.price == 70900.0

        df_ticks = buf.to_dataframe("005930")
        assert len(df_ticks) == 10
        assert "price" in df_ticks.columns

    def test_tier1_streamer_window_bar_aggregator(self):
        """WindowBarAggregator의 실시간 틱 수신 시 캔들 조립 및 윈도우 마감 콜백 검증"""
        closed_bars = []
        agg = WindowBarAggregator(
            symbol="005930",
            interval_seconds=60,
            on_bar_closed=lambda b: closed_bars.append(b)
        )
        base_time = datetime(2026, 8, 31, 9, 0, 0)
        
        # 09:00:10 ~ 09:00:50 틱 (윈도우 1)
        agg.process_tick(TickData(base_time + timedelta(seconds=10), "005930", 70000, 10))
        agg.process_tick(TickData(base_time + timedelta(seconds=20), "005930", 70500, 20))
        agg.process_tick(TickData(base_time + timedelta(seconds=30), "005930", 69800, 15))
        agg.process_tick(TickData(base_time + timedelta(seconds=50), "005930", 70200, 5))

        # 09:01:05 틱 (윈도우 2 시작 -> 이전 윈도우 마감 트리거)
        closed = agg.process_tick(TickData(base_time + timedelta(seconds=65), "005930", 70300, 10))
        assert closed is not None
        assert len(closed_bars) == 1
        b = closed_bars[0]
        assert b.open == 70000
        assert b.high == 70500
        assert b.low == 69800
        assert b.close == 70200
        assert b.volume == 50

    def test_tier1_consolidator_pit_merge(self):
        """DataConsolidator의 Point-in-Time merge_asof 및 동적 지표 생성 검증"""
        # 가상 일봉 주가 데이터
        dates = pd.date_range("2024-01-02", "2024-06-30", freq="B")
        prices = pd.DataFrame({
            "date": dates,
            "symbol": "005930",
            "open": 70000.0,
            "high": 71000.0,
            "low": 69000.0,
            "close": 70000.0,
            "volume": 100000,
            "timeframe": "1d",
            "is_trading_halt": False
        })

        # 가상 펀더멘털 데이터 (2023 사업보고서: 공시일 2024-03-15, 2024 1분기: 공시일 2024-05-15)
        fundamentals = pd.DataFrame([
            {
                "symbol": "005930",
                "period_end": pd.to_datetime("2023-12-31"),
                "announcement_date": pd.to_datetime("2024-03-15"),
                "revenue": 250_000_000_000_000,
                "operating_income": 6_500_000_000_000,
                "net_income": 15_000_000_000_000,
                "eps": 2131.0,
                "bps": 52000.0,
                "validation_status": "PASSED"
            },
            {
                "symbol": "005930",
                "period_end": pd.to_datetime("2024-03-31"),
                "announcement_date": pd.to_datetime("2024-05-15"),
                "revenue": 71_000_000_000_000,
                "operating_income": 6_600_000_000_000,
                "net_income": 6_700_000_000_000,
                "eps": 980.0,
                "bps": 53000.0,
                "validation_status": "PASSED"
            }
        ])

        consolidator = DataConsolidator()
        merged = consolidator.consolidate_point_in_time(prices, fundamentals, "005930")

        assert not merged.empty
        assert len(merged) == len(prices)
        assert "dynamic_per" in merged.columns
        assert "dynamic_pbr" in merged.columns
        assert "returns_1d" in merged.columns
        assert "volatility_20d" in merged.columns
        assert "is_cross_verified" in merged.columns

    def test_tier1_parquet_storage_zstd_roundtrip(self):
        """PyArrow ZSTD 압축 Parquet 저장 및 로드 라운드트립 무결성 검증"""
        df_orig = pd.DataFrame({
            "date": pd.date_range("2024-01-01", periods=10, freq="D"),
            "symbol": ["005930"] * 10,
            "open": [70000.0 + i for i in range(10)],
            "close": [70500.0 + i for i in range(10)],
            "volume": [1000 + i for i in range(10)],
            "dynamic_per": [15.2] * 10,
            "is_cross_verified": [True] * 10,
            "warning_flags": ["NORMAL"] * 10
        })

        with tempfile.TemporaryDirectory() as tmpdir:
            fpath = pathlib.Path(tmpdir) / "test_005930.parquet"
            DataConsolidator.save_to_parquet(df_orig, filepath=fpath, compression='ZSTD')
            assert fpath.exists()
            assert fpath.stat().st_size > 0

            df_loaded = DataConsolidator.load_from_parquet(fpath)
            assert len(df_loaded) == len(df_orig)
            assert list(df_loaded.columns) == list(df_orig.columns)
            assert (df_loaded['close'] == df_orig['close']).all()


# =====================================================================
# TIER 2: Boundary & Error Defense Tests (경계 및 에러 방어)
# =====================================================================

class TestTier2BoundaryAndErrorDefense:
    """
    Tier 2: 교차 검증 오차율 경계값, 결측/이상치, DART Fallback, 링버퍼 오버플로우, Look-ahead bias 방지
    """

    def test_tier2_cross_validation_boundary_4_9_percent_pass(self):
        """오차율 4.9% (< 5.0%): ValidationStatus.PASSED 판정 검증"""
        validator = FundamentalCrossValidator(warning_threshold=5.0, critical_threshold=10.0)
        stmt_a = FinancialStatement(ticker="005930", year=2024, source="DART", revenue=10000)
        stmt_b = FinancialStatement(ticker="005930", year=2024, source="NAVER", revenue=9510) # 4.9% diff

        report = validator.validate_statements(stmt_a, stmt_b, metrics_to_compare=["revenue"])
        assert report.status == ValidationStatus.PASSED
        assert report.items["revenue"].status == ValidationStatus.PASSED
        assert report.items["revenue"].is_valid is True
        assert len(report.warnings) == 0
        assert len(report.errors) == 0

    def test_tier2_cross_validation_boundary_5_1_percent_warning(self, caplog):
        """오차율 5.1% (5.0% <= diff < 10.0%): ValidationStatus.WARNING 및 Warning 로깅 검증"""
        validator = FundamentalCrossValidator(warning_threshold=5.0, critical_threshold=10.0)
        stmt_a = FinancialStatement(ticker="005930", year=2024, source="DART", revenue=10000)
        stmt_b = FinancialStatement(ticker="005930", year=2024, source="NAVER", revenue=9490) # 5.1% diff

        with caplog.at_level(logging.WARNING):
            report = validator.validate_statements(stmt_a, stmt_b, metrics_to_compare=["revenue"])

        assert report.status == ValidationStatus.WARNING
        assert report.items["revenue"].status == ValidationStatus.WARNING
        assert report.items["revenue"].is_valid is True
        assert len(report.warnings) == 1
        assert "WARNING: revenue discrepancy" in caplog.text

    def test_tier2_cross_validation_boundary_10_1_percent_critical(self, caplog):
        """오차율 10.1% (>= 10.0%): ValidationStatus.CRITICAL_DISCREPANCY 및 Error 로깅 검증"""
        validator = FundamentalCrossValidator(warning_threshold=5.0, critical_threshold=10.0)
        stmt_a = FinancialStatement(ticker="005930", year=2024, source="DART", revenue=10000)
        stmt_b = FinancialStatement(ticker="005930", year=2024, source="NAVER", revenue=8990) # 10.1% diff

        with caplog.at_level(logging.ERROR):
            report = validator.validate_statements(stmt_a, stmt_b, metrics_to_compare=["revenue"])

        assert report.status == ValidationStatus.CRITICAL_DISCREPANCY
        assert report.items["revenue"].status == ValidationStatus.CRITICAL_DISCREPANCY
        assert report.items["revenue"].is_valid is False
        assert len(report.errors) == 1
        assert "CRITICAL: revenue discrepancy" in caplog.text

    def test_tier2_negative_operating_income_and_per_masking(self):
        """적자 기업(영업손실, 순손실, EPS <= 0)에 대해 Dynamic PER = NaN 마스킹 및 플래그 검증"""
        prices = pd.DataFrame({
            "date": [pd.to_datetime("2024-06-01")],
            "symbol": ["999999"],
            "close": [50000.0],
            "volume": [1000]
        })
        fundamentals = pd.DataFrame([{
            "symbol": "999999",
            "announcement_date": pd.to_datetime("2024-05-15"),
            "operating_income": -50_000_000_000,
            "net_income": -70_000_000_000,
            "eps": -1200.0,
            "bps": 25000.0,
            "validation_status": "PASSED"
        }])

        consolidator = DataConsolidator()
        merged = consolidator.consolidate_point_in_time(prices, fundamentals, "999999")
        
        assert pd.isna(merged['dynamic_per'].iloc[0])
        assert not pd.isna(merged['dynamic_pbr'].iloc[0])
        assert merged['dynamic_pbr'].iloc[0] == 50000.0 / 25000.0
        assert "NEGATIVE_EPS" in merged['warning_flags'].iloc[0]
        assert "OPERATING_LOSS" in merged['warning_flags'].iloc[0]

    def test_tier2_missing_per_and_field_level_coalesce(self):
        """1순위(DART)에 없는 PER/PBR을 2순위(Naver)로부터 Field-level Coalesce 병합 검증"""
        stmt_dart = FinancialStatement(
            ticker="005930", year=2024, source="DART",
            revenue=300_000_000_000_000, operating_profit=30_000_000_000_000,
            per=None, pbr=None
        )
        stmt_naver = FinancialStatement(
            ticker="005930", year=2024, source="NAVER",
            revenue=298_000_000_000_000, operating_profit=29_500_000_000_000,
            per=14.5, pbr=1.4
        )

        merged_stmt = FundamentalCrossValidator.coalesce_statements(stmt_dart, stmt_naver)
        assert merged_stmt.per == 14.5
        assert merged_stmt.pbr == 1.4
        assert merged_stmt.revenue == 300_000_000_000_000 # DART 수치 우선 유지

    def test_tier2_dart_key_missing_automatic_fallback(self):
        """DART API Key가 None인 환경에서 예외 없이 Naver Finance 수집기로 매끄럽게 Fallback 검증"""
        collector = FundamentalDataCollector(dart_api_key=None, mock_mode=False)
        stmts, report = collector.get_financial_statements("005930", PeriodType.ANNUAL)
        assert len(stmts) > 0
        assert stmts[0].revenue is not None
        assert stmts[0].validation_status in [ValidationStatus.FALLBACK, ValidationStatus.SINGLE_SOURCE]

    def test_tier2_ringbuffer_overflow_defense_50000_ticks(self):
        """60,000건의 틱 데이터를 지속 Push했을 때 버퍼 크기가 50,000으로 유지되고 최신 50,000건만 보존되는지 검증"""
        capacity = 50000
        buf = CircularBuffer(capacity_per_symbol=capacity)
        base_time = datetime(2026, 8, 31, 9, 0, 0)

        # 60,000개 틱 대량 삽입
        for i in range(60000):
            tick = TickData(
                timestamp=base_time + timedelta(seconds=i),
                symbol="005930",
                price=70000.0 + (i % 1000),
                volume=i,
                accum_volume=i * 10
            )
            buf.append(tick)

        # 50,000개로 고정 및 최신 50,000건(index 10,000 ~ 59,999) 보존 확인
        assert buf.size("005930") == capacity
        recent_100 = buf.get_recent_ticks("005930", count=100)
        assert len(recent_100) == 100
        assert recent_100[-1].volume == 59999

        first_tick = buf.get_recent_ticks("005930", count=capacity)[0]
        assert first_tick.volume == 10000 # 이전 0~9,999 틱은 안전하게 FIFO 폐기됨

    def test_tier2_price_anomaly_and_trading_halt_handling(self):
        """비정상 가격(Low > High) 교정 및 거래정지일(Volume==0) 플래깅 검증"""
        raw_df = pd.DataFrame([
            # 정상 행
            {"date": "2026-08-01", "symbol": "005930", "open": 70000.0, "high": 71000.0, "low": 69000.0, "close": 70500.0, "volume": 1000},
            # 비정상 가격 (low > high)
            {"date": "2026-08-02", "symbol": "005930", "open": 70000.0, "high": 69000.0, "low": 71000.0, "close": 70500.0, "volume": 1000},
            # 거래정지일 (Volume == 0, O == H == L == C)
            {"date": "2026-08-03", "symbol": "005930", "open": 70500.0, "high": 70500.0, "low": 70500.0, "close": 70500.0, "volume": 0},
        ])

        collector = PriceDataCollector()
        cleaned_df, report = collector.validate_and_clean_ohlcv(raw_df)

        assert len(cleaned_df) == 3
        # 2행의 high, low 교정 확인
        assert cleaned_df.iloc[1]['high'] >= cleaned_df.iloc[1]['low']
        # 3행 거래정지 플래그 확인
        assert cleaned_df.iloc[2]['is_trading_halt'] is True

    def test_tier2_lookahead_bias_prevention_boundary(self):
        """
        선행 편향(Look-ahead bias) 원천 차단 검증:
        2024년 1분기(1Q) 실적은 2024-05-15에 공시되므로,
        2024-04-01 ~ 2024-05-14 사이의 거래일에는 1Q 실적이 아닌 이전 공시(2023 사업보고서)가 매핑되어야 함.
        """
        prices = pd.DataFrame({
            "date": pd.date_range("2024-04-01", "2024-05-30", freq="D"),
            "symbol": "005930",
            "open": 70000.0, "high": 70000.0, "low": 70000.0, "close": 70000.0, "volume": 1000
        })

        fundamentals = pd.DataFrame([
            {
                "symbol": "005930",
                "announcement_date": pd.to_datetime("2024-03-15"), # 2023 연간
                "revenue": 250_000_000_000_000,
                "operating_income": 6_500_000_000_000,
                "eps": 2131.0
            },
            {
                "symbol": "005930",
                "announcement_date": pd.to_datetime("2024-05-15"), # 2024 1분기
                "revenue": 71_000_000_000_000,
                "operating_income": 6_600_000_000_000,
                "eps": 980.0
            }
        ])

        consolidator = DataConsolidator()
        merged = consolidator.consolidate_point_in_time(prices, fundamentals, "005930")

        # 2024-05-14 시점의 데이터 검증: 2024 1Q 실적이 아니라 2023 연간 실적(EPS=2131)이어야 함
        row_before = merged[merged['date'] == pd.to_datetime("2024-05-14")].iloc[0]
        assert row_before['eps'] == 2131.0
        assert row_before['revenue'] == 250_000_000_000_000

        # 2024-05-15 시점부터 2024 1Q 실적(EPS=980) 반영 확인
        row_after = merged[merged['date'] == pd.to_datetime("2024-05-15")].iloc[0]
        assert row_after['eps'] == 980.0
        assert row_after['revenue'] == 71_000_000_000_000


# =====================================================================
# TIER 3: Integration & Interaction Tests (결합 상호작용)
# =====================================================================

class TestTier3IntegrationAndInteraction:
    """
    Tier 3: 펀더멘털 + 시계열 주가 + 교차검증 + PIT 병합 + Parquet 저장 라운드트립 결합 파이프라인
    """

    def test_tier3_full_pipeline_roundtrip_flow(self):
        """수집 -> 교차검증 -> PIT 결합 -> Parquet 저장 -> Parquet 복원 라운드트립 완결성 검증"""
        with tempfile.TemporaryDirectory() as tmpdir:
            save_path = pathlib.Path(tmpdir) / "e2e_roundtrip_005930.parquet"

            pipeline = DataPipeline(
                fundamental_collector=FundamentalDataCollector(mock_mode=True),
                price_collector=PriceDataCollector(fetchers=[MockPriceFetcher(seed=999)]),
                consolidator=DataConsolidator()
            )

            df, meta = pipeline.run_pipeline(
                symbol="005930",
                count=100,
                save_raw=True,
                output_filepath=str(save_path)
            )

            assert not df.empty
            assert meta["row_count"] == len(df)
            assert save_path.exists()

            # 복원 후 무결성 검증
            df_reloaded = DataConsolidator.load_from_parquet(save_path)
            assert len(df_reloaded) == len(df)
            assert list(df_reloaded.columns) == list(df.columns)
            assert (df_reloaded['dynamic_per'].fillna(-1) == df['dynamic_per'].fillna(-1)).all()

    def test_tier3_multi_symbol_pipeline_consistency(self):
        """복수 종목(삼성전자 005930, SK하이닉스 000660, 현대차 005380) 독립 파이프라인 무결성 검증"""
        symbols = ["005930", "000660", "005380"]
        pipeline = DataPipeline(
            fundamental_collector=FundamentalDataCollector(mock_mode=True),
            price_collector=PriceDataCollector(fetchers=[MockPriceFetcher(seed=777)])
        )

        with tempfile.TemporaryDirectory() as tmpdir:
            for sym in symbols:
                target_file = pathlib.Path(tmpdir) / f"{sym}.parquet"
                df, meta = pipeline.run_pipeline(
                    symbol=sym,
                    count=30,
                    save_raw=True,
                    output_filepath=str(target_file)
                )
                assert not df.empty
                assert (df['symbol'] == sym).all()
                assert target_file.exists()

    def test_tier3_concurrent_streaming_and_batch_isolation(self):
        """멀티스레드 실시간 틱 수신(10,000틱)과 일봉 배치 데이터 처리가 동시에 수행될 때의 안전성 검증"""
        ring_buffer = RealtimeRingBuffer(capacity_per_symbol=10000)
        stop_event = threading.Event()

        def produce_ticks():
            base_time = datetime.now()
            for i in range(5000):
                if stop_event.is_set():
                    break
                ring_buffer.append(TickData(
                    timestamp=base_time + timedelta(milliseconds=i*10),
                    symbol="005930",
                    price=70000.0 + (i % 50),
                    volume=10
                ))
                if i % 1000 == 0:
                    time.sleep(0.001)

        t = threading.Thread(target=produce_ticks)
        t.start()

        # 배치 파이프라인 동시 실행
        pipeline = DataPipeline(
            fundamental_collector=FundamentalDataCollector(mock_mode=True),
            price_collector=PriceDataCollector(fetchers=[MockPriceFetcher(seed=42)])
        )
        batch_df, _ = pipeline.run_pipeline("005930", count=50, save_raw=False)

        t.join(timeout=5)
        stop_event.set()

        assert not batch_df.empty
        assert ring_buffer.size("005930") > 0


# =====================================================================
# TIER 4: Real-World Scenarios (실세계 시나리오)
# =====================================================================

class TestTier4RealWorldScenarios:
    """
    Tier 4: 삼성전자('005930') 실데이터 E2E 수집/검증/저장 파이프라인 구동 및 data/raw/ Parquet 생성 검증
    """

    def test_tier4_samsung_electronics_live_e2e_pipeline(self):
        """
        [핵심 요구사항 R4 Acceptance Criteria]
        삼성전자('005930') 실데이터 E2E 수집, 교차검증, PIT 병합, data/raw/ 저장 및 로드 완결성 검증
        """
        pipeline = DataPipeline(
            fundamental_collector=FundamentalDataCollector(mock_mode=False),
            price_collector=PriceDataCollector(fetchers=[NaverPriceFetcher()]),
            consolidator=DataConsolidator()
        )

        raw_dir = pathlib.Path(PROJECT_ROOT) / "data" / "raw"
        raw_dir.mkdir(parents=True, exist_ok=True)
        target_parquet = raw_dir / "005930_consolidated.parquet"

        # E2E 파이프라인 구동
        consolidated_df, meta = pipeline.run_pipeline(
            symbol="005930",
            count=100,
            save_raw=True,
            output_filepath=str(target_parquet)
        )

        # 1. 반환 데이터프레임 무결성 검증
        assert not consolidated_df.empty, "Consolidated DataFrame must not be empty"
        assert len(consolidated_df) >= 50, "At least 50 trading days expected"
        assert (consolidated_df['symbol'] == "005930").all()
        assert "dynamic_per" in consolidated_df.columns
        assert "dynamic_pbr" in consolidated_df.columns
        assert "returns_1d" in consolidated_df.columns

        # 2. Parquet 파일 생성 및 스토리지 검증
        assert target_parquet.exists(), f"Target Parquet file must exist at {target_parquet}"
        assert target_parquet.stat().st_size > 0, "Parquet file size must be greater than 0 bytes"

        # 3. Parquet 재로딩 및 수치 일치성 검증
        df_loaded = DataConsolidator.load_from_parquet(target_parquet)
        assert len(df_loaded) == len(consolidated_df)
        assert (df_loaded['close'] == consolidated_df['close']).all()
        assert (df_loaded['symbol'] == "005930").all()

    def test_tier4_network_fault_tolerant_pipeline_recovery(self):
        """네트워크 단절 및 DART Key 부재 상황에서도 Fallback을 통해 무중단 수집 및 Parquet 저장 검증"""
        # DART Key 미지정 상태에서 Live Naver로 Fallback 수집
        collector = FundamentalDataCollector(dart_api_key=None, mock_mode=False)
        df_fund = collector.get_as_dataframe("005930", PeriodType.ANNUAL)
        assert not df_fund.empty

        # 가격 데이터도 정상 병합되는지 확인
        pipeline = DataPipeline(
            fundamental_collector=collector,
            price_collector=PriceDataCollector(fetchers=[NaverPriceFetcher()]),
            consolidator=DataConsolidator()
        )
        with tempfile.TemporaryDirectory() as tmpdir:
            fpath = pathlib.Path(tmpdir) / "fallback_005930.parquet"
            res_df, meta = pipeline.run_pipeline("005930", count=20, save_raw=True, output_filepath=str(fpath))
            assert not res_df.empty
            assert fpath.exists()

    def test_tier4_stress_50000_ticks_streaming_pipeline(self):
        """50,000건 대규모 틱 스트리밍 부하 상황에서 버퍼 캐시 오버플로우 방어 및 캔들 조립 무결성 검증"""
