import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import pandas as pd
import os
import sys
import pickle
import argparse
from torch.utils.data import TensorDataset, DataLoader

# Set num threads to reduce CPU contention
torch.set_num_threads(2)

# Add Command/core to path for lock manager and audit logger
sys.path.append("/home/imnyj/Command/core")
from lock_manager import LockManager
from audit_logger import AuditLogger

from dataset import get_dataloaders
from models import (
    H_ST_MBAN, 
    H_ST_MBAN_noAttn, 
    H_ST_MBAN_EarlyFusion, 
    H_ST_MBAN_noS, 
    H_ST_MBAN_noT, 
    H_ST_MBAN_noK
)

DATA_DIRS = [
    "/home/imnyj/SumoNetSim1.1.6/data",
    "/home/imnyj/papers/paper1/paper/data(Desk01)",
    "/home/imnyj/papers/paper1/paper/data(Desk02)"
]
EPOCHS = 200
BATCH_SIZE = 2048

def train_and_eval_curve(model_name, model, train_loader, val_loader, device, has_hybrid=False):
    model = model.to(device)
    optimizer = optim.AdamW(model.parameters(), lr=0.001, weight_decay=1e-4)
    criterion = nn.L1Loss()
    
    history = []
    
    # --- Epoch 0 (Untrained state) ---
    model.eval()
    val_mae_0 = 0.0
    count_0 = 0
    with torch.no_grad():
        for batch in val_loader:
            x_k, x_t, x_s, xp, y = [b.to(device, non_blocking=True) for b in batch]
            if has_hybrid:
                preds = model(x_k, x_t, x_s, ml_preds=xp)
            else:
                preds = model(x_k, x_t, x_s)
            val_mae_0 += torch.sum(torch.abs(preds - y)).item()
            count_0 += y.numel()
    mae_0 = val_mae_0 / count_0
    history.append({"Model": model_name, "Epoch": 0, "MAE": mae_0})
    print(f"[{model_name}] Epoch 0/{EPOCHS} (Untrained) Val MAE: {mae_0:.4f}")
    
    # --- Epoch Loop ---
    for ep in range(1, EPOCHS + 1):
        model.train()
        for batch in train_loader:
            x_k, x_t, x_s, xp, y = [b.to(device, non_blocking=True) for b in batch]
            optimizer.zero_grad()
            
            if has_hybrid:
                preds = model(x_k, x_t, x_s, ml_preds=xp)
            else:
                preds = model(x_k, x_t, x_s)
                
            loss = criterion(preds, y)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            
        # Validation at end of epoch
        model.eval()
        val_mae = 0.0
        count = 0
        with torch.no_grad():
            for batch in val_loader:
                x_k, x_t, x_s, xp, y = [b.to(device, non_blocking=True) for b in batch]
                if has_hybrid:
                    preds = model(x_k, x_t, x_s, ml_preds=xp)
                else:
                    preds = model(x_k, x_t, x_s)
                val_mae += torch.sum(torch.abs(preds - y)).item()
                count += y.numel()
        
        mae = val_mae / count
        history.append({"Model": model_name, "Epoch": ep, "MAE": mae})
        if ep % 20 == 0 or ep == 1:
            print(f"[{model_name}] Epoch {ep}/{EPOCHS} Val MAE: {mae:.4f}")
            
    return history

def safe_write_csv(df, path, agent_id="worker_g2"):
    lm = LockManager()
    logger = AuditLogger()
    if lm.acquire(path, agent_id):
        try:
            df.to_csv(path, index=False)
            logger.log_action(agent_id, "MODIFY", path, f"Wrote CSV results to {path}")
        finally:
            lm.release(path, agent_id)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--model_name", type=str, required=True, help="Name of the model to train")
    parser.add_argument("--device", type=str, default="cuda:0", help="GPU device to use")
    args = parser.parse_args()
    
    device = torch.device(args.device if torch.cuda.is_available() else "cpu")
    print(f"Training model {args.model_name} on device {device}...")
    
    # Instantiate correct model and hybrid flag
    use_hybrid = True
    if args.model_name == "w/o Hybrid":
        model = H_ST_MBAN()
        use_hybrid = False
    elif args.model_name == "w/o Attention":
        model = H_ST_MBAN_noAttn()
    elif args.model_name == "Early Fusion":
        model = H_ST_MBAN_EarlyFusion()
    elif args.model_name == "w/o Social (S)":
        model = H_ST_MBAN_noS()
    elif args.model_name == "w/o Traffic (T)":
        model = H_ST_MBAN_noT()
    elif args.model_name == "w/o Kinematic (K)":
        model = H_ST_MBAN_noK()
    else:
        print(f"Unknown model name: {args.model_name}")
        sys.exit(1)
        
    print("Loading precomputed datasets and XGBoost predictions...")
    with open("/home/imnyj/papers/paper1/data/ablation_precomputed_data.pkl", "rb") as f:
        precomputed_data = pickle.load(f)
        
    all_xk = precomputed_data["all_xk"]
    all_xt = precomputed_data["all_xt"]
    all_xs = precomputed_data["all_xs"]
    xp_train = precomputed_data["xp_train"]
    all_y = precomputed_data["all_y"]
    
    val_xk = precomputed_data["val_xk"]
    val_xt = precomputed_data["val_xt"]
    val_xs = precomputed_data["val_xs"]
    xp_val = precomputed_data["xp_val"]
    val_y = precomputed_data["val_y"]
    
    train_loader_hybrid = DataLoader(
        TensorDataset(all_xk, all_xt, all_xs, xp_train, all_y), 
        batch_size=BATCH_SIZE, 
        shuffle=True,
        num_workers=0,
        pin_memory=False
    )
    
    val_loader_hybrid = DataLoader(
        TensorDataset(val_xk, val_xt, val_xs, xp_val, val_y), 
        batch_size=BATCH_SIZE, 
        shuffle=False,
        num_workers=0,
        pin_memory=False
    )

    print(f"Starting training of {args.model_name}...")
    history = train_and_eval_curve(args.model_name, model, train_loader_hybrid, val_loader_hybrid, device, has_hybrid=use_hybrid)
    
    # Save to temp CSV
    out_path = f"/home/imnyj/papers/paper1/data/ablation_temp_{args.model_name.replace(' ', '_').replace('/', '_').replace('(', '').replace(')', '')}.csv"
    df = pd.DataFrame(history)
    safe_write_csv(df, out_path)
    print(f"Saved intermediate curve to {out_path}")

if __name__ == "__main__":
    main()
