import re
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

log_path = "/home/imnyj/.gemini/antigravity-cli/brain/bd55b32a-994c-49a9-a934-ac0a05baf976/.system_generated/tasks/task-5492.log"

data = []
current_model = None

with open(log_path, "r") as f:
    for line in f:
        line = line.strip()
        if "Training " in line and "..." in line:
            # e.g., Training H-ST-MBAN (Proposed)...
            current_model = line.replace("Training ", "").replace("...", "")
            # Add epoch 0 with a dummy high value based on the first epoch to make curve look nice? 
            # Or just parse epochs
        elif line.startswith("[") and "Epoch" in line and "Val MAE:" in line:
            # [H-ST-MBAN (Proposed)] Epoch 20/200 Val MAE: 20.8586 (Best: 20.8586)
            match = re.search(r"Epoch (\d+)/\d+ Val MAE: ([\d\.]+)", line)
            if match:
                epoch = int(match.group(1))
                val_mae = float(match.group(2))
                data.append({"Model": current_model, "Epoch": epoch, "MAE": val_mae})

df = pd.DataFrame(data)

# Since w/o Hybrid has much higher MAE (~46), it ruins the y-axis scale for the others (~20-22).
# We might want to plot w/o Hybrid on a separate axis or just plot them all together.
# Let's plot them all together but maybe with log scale or just normal.
plt.figure(figsize=(10, 6))
sns.lineplot(data=df, x="Epoch", y="MAE", hue="Model", marker="o")
plt.title("G2 Ablation Study - Learning Curves")
plt.ylabel("Validation MAE")
plt.xlabel("Epochs")
plt.legend(title="Models", bbox_to_anchor=(1.05, 1), loc='upper left')
plt.grid(True)
plt.tight_layout()
plt.savefig("/home/imnyj/papers/paper1/figure/G2_ablation_learning_curves.png")
plt.close()
print("Learning curves plotted successfully.")
