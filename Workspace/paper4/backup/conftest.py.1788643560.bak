# tests/conftest.py
# ============================================================================
# Pytest Fixtures for 4-Tier AoI-aware V2I Uplink RL Testing Suite
# ============================================================================

import os
import shutil
import tempfile

# ----------------------------------------------------------------------------
# Scenario isolation. MUST run before any `src.` import below.
#
# `prepare_scenario` shortens `ss.FLOW_END_S` to fit the run it is about to do,
# which is right in itself -- a 200-step test has no use for 3600 s of demand --
# and then regenerates the SUMO files. With PAPER4_SUMO_DIR unset those files land
# in `coder/src/sumo/`, the shared directory every process falls back to, so the
# side effect outlives the process that caused it. On 2026-09-05 that directory
# was observed cycling through FLOW_END_S 131 s, 51 s and 138 s as different test
# runs finished; against a 120 s warm-up, anything that read it next would have
# measured a road that was already draining. Nothing raises, the tests pass, and
# the damage appears in whatever runs afterwards.
#
# Two agents in two sessions caused it on the same afternoon, neither aware there
# was a convention to follow, which is the argument for putting the isolation here
# rather than in a rule people are asked to remember.
#
# Set at module scope, not in a fixture: `make_sumo_set.BASE_PATH` is resolved
# once at import, and the `from src.rl_interface import STATE_DIM` below is enough
# to pull that module in. A fixture, even session-scoped and autouse, runs after
# collection has already imported it, and would silently do nothing.
#
# `setdefault`, so a caller that already points PAPER4_SUMO_DIR somewhere keeps
# its own directory.
_ISOLATED_SUMO_DIR = None
if not os.environ.get("PAPER4_SUMO_DIR"):
    _ISOLATED_SUMO_DIR = tempfile.mkdtemp(prefix="paper4_sumo_tests_")
    os.environ["PAPER4_SUMO_DIR"] = _ISOLATED_SUMO_DIR

import pytest
import numpy as np
import torch
from tests.contract_adapters import DummyPolicy, StateVectorizer, ActionDecoder, RetrospectiveReplayBuffer
from src.rl_interface import STATE_DIM


class DummyNode:
    def __init__(self, node_id: str, pos=(0.0, 0.0), vel=(10.0, 0.0), comm_range=300.0) -> None:
        self.id = node_id
        self.pos = list(pos)
        self.vel = list(vel)
        self.comm_range = float(comm_range)
        self._prev_pos = list(pos)
        self._prev_t = 0.0
        self.accel = 0.0

    def speed(self) -> float:
        return float(np.hypot(self.vel[0], self.vel[1]))

    def distance_to(self, other) -> float:
        return float(np.hypot(self.pos[0] - other.pos[0], self.pos[1] - other.pos[1]))


@pytest.fixture
def synthetic_vehicle_node():
    return DummyNode("veh_test_01", pos=(150.0, 200.0), vel=(12.0, 0.0), comm_range=300.0)


@pytest.fixture
def synthetic_rsu_node():
    return DummyNode("rsu_test_01", pos=(0.0, 0.0), comm_range=300.0)


@pytest.fixture
def sample_state_vector():
    # Observation vector, width owned by src/rl_interface.py::STATE_DIM
    return np.random.uniform(-0.5, 0.5, size=(STATE_DIM,)).astype(np.float32)


@pytest.fixture
def sample_batch():
    batch_size = 32
    return {
        "state": torch.randn(batch_size, STATE_DIM, dtype=torch.float32),
        "action": torch.randn(batch_size, 3, dtype=torch.float32),
        "reward": torch.randn(batch_size, 1, dtype=torch.float32),
        "next_state": torch.randn(batch_size, STATE_DIM, dtype=torch.float32),
        "done": torch.zeros(batch_size, 1, dtype=torch.float32),
        "delta_t": torch.ones(batch_size, 1, dtype=torch.float32) * 1.5,
    }


@pytest.fixture
def model_factory():
    def _create_model(model_name: str = "DummyPolicy", **kwargs):
        return DummyPolicy(**kwargs)
    return _create_model


@pytest.fixture
def temp_results_dir():
    d = tempfile.mkdtemp(prefix="aoi_test_results_")
    yield d
    shutil.rmtree(d, ignore_errors=True)


@pytest.fixture(scope="session", autouse=True)
def _sumo_scenario_isolation():
    """Assert the isolation held, and remove the directory this run created.

    The env var is set above at import time; this fixture does the two things a
    fixture actually can. It fails the whole session if `BASE_PATH` did not end up
    inside the isolated directory -- a redirect that quietly stopped working would
    otherwise show up only as another polluted shared directory days later -- and
    it cleans up afterwards, but only a directory this process made. A caller that
    supplied its own PAPER4_SUMO_DIR keeps it.
    """
    import src.sumo.make_sumo_set as ss

    wanted = os.environ.get("PAPER4_SUMO_DIR")
    assert wanted, "PAPER4_SUMO_DIR was not set; scenario isolation is not in place"
    assert os.path.realpath(ss.BASE_PATH) == os.path.realpath(wanted), (
        f"make_sumo_set.BASE_PATH is {ss.BASE_PATH!r}, not the isolated "
        f"{wanted!r}. Generated scenarios would land in the shared directory."
    )
    yield
    if _ISOLATED_SUMO_DIR:
        shutil.rmtree(_ISOLATED_SUMO_DIR, ignore_errors=True)


def pytest_configure(config):
    """Register the markers this suite uses so `-W error` stays usable."""
    config.addinivalue_line(
        "markers",
        "slow: exercises a real SUMO episode (seconds, not milliseconds)",
    )
