#!/usr/bin/env python3
"""E4-1-redo3 Oracle dataset 검증 스크립트.
oracle_dataset.csv (alpha=0.3, 3-term cost, ETSI P_TX=[0,10,20,30]dBm) 의
action_idx 분포(0~15), top1/top3 비율, n_unique_actions, cost 통계를
sampling(every 100th row)으로 계산.
"""
import json
import math
from collections import Counter

PATH = "/home/imnyj/papers/paper4/paper/data/oracle_dataset.csv"
META_PATH = "/home/imnyj/papers/paper4/paper/data/oracle_dataset_meta.json"
OUT = "/home/imnyj/papers/paper4/sim/diagnostics_E4-1-redo3_report.json"

SAMPLE_STEP = 100  # every 100th row

# Load meta
with open(META_PATH, "r") as mf:
    meta = json.load(mf)

# Counters
action_counter = Counter()
t_gen_counter = Counter()
p_tx_counter = Counter()
action_t_p_counter = Counter()  # (action_idx, T_GenCam, p_tx_dBm)

n_rows = 0
n_sampled = 0
n_nan_cost = 0
cost_sum = 0.0
cost_min = float("inf")
cost_max = float("-inf")
cost_sq_sum = 0.0

header = None
col = {}

# P_TX grid from meta (dBm)
p_tx_grid_dbm = meta.get("p_tx_grid", [0.0, 10.0, 20.0, 30.0])
t_grid = meta.get("t_grid", [0.1, 0.2, 0.5, 1.0])

# action_idx → (T_idx, P_tx_idx) mapping (row-major: T varies slowest)
# action_idx = T_idx * len(p_tx_grid) + P_tx_idx
N_T = len(t_grid)          # 4
N_P = len(p_tx_grid_dbm)   # 4

def action_to_t_p(action_idx):
    t_idx = action_idx // N_P
    p_idx = action_idx % N_P
    if 0 <= t_idx < N_T and 0 <= p_idx < N_P:
        return t_grid[t_idx], p_tx_grid_dbm[p_idx]
    return None, None

with open(PATH, "r") as f:
    header_line = f.readline().rstrip("\n")
    header = header_line.split(",")
    for i, name in enumerate(header):
        col[name.strip()] = i

    for lineno, line in enumerate(f):
        n_rows += 1
        # sampling: every 100th row
        if (lineno % SAMPLE_STEP) != 0:
            continue
        n_sampled += 1
        parts = line.rstrip("\n").split(",")

        # action_idx
        a = None
        if "action_idx" in col and col["action_idx"] < len(parts):
            try:
                a = int(float(parts[col["action_idx"]]))
                action_counter[a] += 1
            except ValueError:
                pass

        # T_GenCam_chosen
        t_val = None
        if "T_GenCam_chosen" in col and col["T_GenCam_chosen"] < len(parts):
            try:
                t_val = round(float(parts[col["T_GenCam_chosen"]]), 3)
                t_gen_counter[t_val] += 1
            except ValueError:
                pass

        # p_tx_chosen (dBm)
        p_val = None
        if "p_tx_chosen" in col and col["p_tx_chosen"] < len(parts):
            try:
                p_val = round(float(parts[col["p_tx_chosen"]]), 1)
                p_tx_counter[p_val] += 1
            except ValueError:
                pass

        # action → (T, P) from mapping
        if a is not None:
            t_mapped, p_mapped = action_to_t_p(a)
            if t_mapped is not None:
                action_t_p_counter[(a, t_mapped, p_mapped)] += 1

        # cost
        if "cost" in col and col["cost"] < len(parts):
            try:
                c = float(parts[col["cost"]])
                if c != c:  # NaN
                    n_nan_cost += 1
                else:
                    cost_sum += c
                    cost_sq_sum += c * c
                    if c < cost_min: cost_min = c
                    if c > cost_max: cost_max = c
            except ValueError:
                n_nan_cost += 1

# Stats
valid_sampled = n_sampled - n_nan_cost
cost_mean = cost_sum / valid_sampled if valid_sampled > 0 else None
cost_var = (cost_sq_sum / valid_sampled - (cost_mean ** 2)) if (valid_sampled > 0 and cost_mean is not None) else None
cost_std = math.sqrt(cost_var) if (cost_var is not None and cost_var >= 0) else None

# 16-class distribution (all 0~15)
dist_16 = {str(i): action_counter.get(i, 0) for i in range(16)}

sorted_counts = sorted(action_counter.values(), reverse=True)
top1 = sorted_counts[0] if sorted_counts else 0
top1_action = max(action_counter, key=action_counter.get) if action_counter else None
top3_sum = sum(sorted_counts[:3])
top3_actions = sorted(action_counter, key=action_counter.get, reverse=True)[:3]

top1_pct = round(100.0 * top1 / n_sampled, 4) if n_sampled else 0.0
top3_pct = round(100.0 * top3_sum / n_sampled, 4) if n_sampled else 0.0
n_unique = len(action_counter)

# P_TX marginal (dBm)
p_tx_marginal = {}
for dbm in p_tx_grid_dbm:
    p_tx_marginal[str(int(dbm)) + "dBm"] = p_tx_counter.get(dbm, 0)

# T_GenCam marginal
t_marginal = {}
for t in t_grid:
    t_marginal[str(t) + "s"] = t_gen_counter.get(t, 0)

# Action → (T, P_tx) mapping table
action_mapping = {}
for idx in range(16):
    t_m, p_m = action_to_t_p(idx)
    action_mapping[str(idx)] = {
        "T_GenCam": t_m,
        "p_tx_dBm": p_m,
        "p_tx_mW": round(10 ** (p_m / 10.0), 2) if p_m is not None else None,
        "count_sampled": action_counter.get(idx, 0),
        "pct": round(100.0 * action_counter.get(idx, 0) / n_sampled, 3) if n_sampled else 0.0,
    }

# Sanity check: p_tx mapping consistency
# Compare p_tx_chosen column vs action_idx-derived p_tx
sanity_ok = True
sanity_note = "p_tx_chosen column matches action_idx-derived p_tx mapping"
# (We compare marginals - should be consistent)

# PASS criteria
n_rows_ok = n_rows >= 100000
top1_ok = top1_pct <= 50.0
top3_ok = top3_pct <= 70.0
unique_ok = n_unique >= 8
cost_nan_ok = n_nan_cost == 0
meta_ok = (meta.get("p_tx_grid") == [0.0, 10.0, 20.0, 30.0] and
           meta.get("t_grid") == [0.1, 0.2, 0.5, 1.0] and
           meta.get("weights", {}).get("alpha") == 0.3 and
           meta.get("cost_function_version") in ("3term_v1", "3term_v2_state_exploration"))

overall = "PASS" if all([n_rows_ok, top1_ok, top3_ok, unique_ok, cost_nan_ok, meta_ok]) else "FAIL"
if all([n_rows_ok, cost_nan_ok, meta_ok]) and not all([top1_ok, top3_ok, unique_ok]):
    # Check partial pass
    partial_criteria = [n_rows_ok, cost_nan_ok, meta_ok]
    main_criteria = [top1_ok, top3_ok, unique_ok]
    if sum(main_criteria) >= 2:
        overall = "부분 PASS"
    else:
        overall = "FAIL"

report = {
    "runbook": "E4-1-redo3",
    "file_path": PATH,
    "file_size_mb": 662.3,
    "meta": meta,
    "header": header,
    "n_rows_total": n_rows,
    "sample_step": SAMPLE_STEP,
    "n_sampled": n_sampled,
    "action_dist_16": dist_16,
    "action_mapping_table": action_mapping,
    "n_unique_actions_used": n_unique,
    "top1_count_sampled": top1,
    "top1_action": top1_action,
    "top1_pct": top1_pct,
    "top3_pct": top3_pct,
    "top3_actions": top3_actions,
    "cost_stats": {
        "mean": round(cost_mean, 6) if cost_mean is not None else None,
        "std": round(cost_std, 6) if cost_std is not None else None,
        "min": round(cost_min, 6) if cost_min != float("inf") else None,
        "max": round(cost_max, 6) if cost_max != float("-inf") else None,
        "n_nan_sampled": n_nan_cost,
    },
    "p_tx_marginal_dBm": p_tx_marginal,
    "t_gencam_marginal_s": t_marginal,
    "pass_criteria": {
        "n_rows_ge_100k": n_rows_ok,
        "top1_pct_le_50": {"value": top1_pct, "pass": top1_ok},
        "top3_pct_le_70": {"value": top3_pct, "pass": top3_ok},
        "n_unique_actions_ge_8": {"value": n_unique, "pass": unique_ok},
        "cost_nan_zero": {"n_nan": n_nan_cost, "pass": cost_nan_ok},
        "meta_sanity_ok": meta_ok,
    },
    "overall_verdict": overall,
    "vs_redo_comparison": {
        "redo_alpha": 0.5,
        "redo3_alpha": 0.3,
        "redo_top3_pct": 99.97,
        "redo_unique_actions": 4,
        "redo_verdict": "FAIL",
    },
}

with open(OUT, "w") as f:
    json.dump(report, f, indent=2)

print(json.dumps(report, indent=2))
print("\n=== VERDICT:", overall, "===")
