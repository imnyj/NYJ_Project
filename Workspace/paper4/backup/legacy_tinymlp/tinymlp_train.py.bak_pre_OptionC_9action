#!/usr/bin/env python3
"""
E4-2 TinyMLP Behavior Cloning Training Script
Architecture: 5 → 8 → 8 → 16 (softmax)
"""

import argparse
import json
import os
import pickle
import random
import sys
import time
import math

import numpy as np

# Try to import PyTorch; fall back to numpy-only implementation
try:
    import torch
    import torch.nn as nn
    import torch.optim as optim
    from torch.utils.data import DataLoader, TensorDataset
    HAS_TORCH = True
    print("[INFO] PyTorch available, using torch backend.")
except ImportError:
    HAS_TORCH = False
    print("[INFO] PyTorch not available, using numpy-only fallback.")

import pandas as pd


# ─────────────────────────────────────────────
# 1. Argument parsing
# ─────────────────────────────────────────────
def parse_args():
    p = argparse.ArgumentParser(description="TinyMLP Behavior Cloning Training")
    p.add_argument("--dataset",    default="paper/data/oracle_dataset.csv")
    p.add_argument("--epochs",     type=int,   default=80)
    p.add_argument("--batch_size", type=int,   default=256)
    p.add_argument("--lr",         type=float, default=1e-3)
    p.add_argument("--hidden_dim", type=int,   default=8)
    p.add_argument("--seed",       type=int,   default=42)
    p.add_argument("--output",     default="sim/tinymlp_model.pkl")
    p.add_argument("--log",        default="sim/train_log.json")
    p.add_argument("--max_rows",   type=int,   default=1_000_000,
                   help="Max rows to use (0 = all). Default 1M for speed.")
    return p.parse_args()


# ─────────────────────────────────────────────
# 2. Reproducibility
# ─────────────────────────────────────────────
def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    if HAS_TORCH:
        torch.manual_seed(seed)


# ─────────────────────────────────────────────
# 3. Data loading
# ─────────────────────────────────────────────
FEATURE_COLS = ["cbr_global", "n_neighbors", "v_norm", "dt_since_last_cam", "cbr_smoothed"]
LABEL_COL    = "action_idx"

def load_data(dataset_path, max_rows, seed):
    print(f"[DATA] Loading from {dataset_path} ...")
    t0 = time.time()

    # Count total rows without reading all
    needed_cols = FEATURE_COLS + [LABEL_COL]
    df = pd.read_csv(dataset_path, usecols=needed_cols, dtype="float32",
                     converters={LABEL_COL: lambda x: int(float(x))})

    total_rows = len(df)
    print(f"[DATA] Total rows: {total_rows:,}. Elapsed: {time.time()-t0:.1f}s")

    if max_rows > 0 and total_rows > max_rows:
        print(f"[DATA] Sampling {max_rows:,} rows (seed={seed}) ...")
        df = df.sample(n=max_rows, random_state=seed)
        subset_rows = max_rows
    else:
        subset_rows = total_rows

    X = df[FEATURE_COLS].values.astype(np.float32)
    y = df[LABEL_COL].values.astype(np.int64)

    print(f"[DATA] X shape: {X.shape}, y shape: {y.shape}")
    print(f"[DATA] y unique values: {np.unique(y)}")
    print(f"[DATA] Load time: {time.time()-t0:.1f}s")

    return X, y, subset_rows


# ─────────────────────────────────────────────
# 4. Train / Val / Test split
# ─────────────────────────────────────────────
def split_data(X, y, seed=42):
    n = len(X)
    idx = np.arange(n)
    rng = np.random.default_rng(seed)
    rng.shuffle(idx)

    n_train = int(n * 0.70)
    n_val   = int(n * 0.15)
    # rest = test

    train_idx = idx[:n_train]
    val_idx   = idx[n_train:n_train+n_val]
    test_idx  = idx[n_train+n_val:]

    return (X[train_idx], y[train_idx],
            X[val_idx],   y[val_idx],
            X[test_idx],  y[test_idx])


# ─────────────────────────────────────────────
# 5a. PyTorch Model
# ─────────────────────────────────────────────
if HAS_TORCH:
    class TinyMLP(nn.Module):
        def __init__(self, in_dim=5, hidden_dim=8, n_classes=16):
            super().__init__()
            self.net = nn.Sequential(
                nn.Linear(in_dim, hidden_dim),
                nn.ReLU(),
                nn.Linear(hidden_dim, hidden_dim),
                nn.ReLU(),
                nn.Linear(hidden_dim, n_classes),
            )

        def forward(self, x):
            return self.net(x)  # logits; CrossEntropyLoss applies softmax internally


def count_params_torch(model):
    return sum(p.numel() for p in model.parameters())


# ─────────────────────────────────────────────
# 5b. Numpy-only MLP (fallback)
# ─────────────────────────────────────────────
class NumpyMLP:
    """3-layer MLP: 5→8→8→16 with ReLU hidden, softmax output."""

    def __init__(self, in_dim=5, hidden_dim=8, n_classes=16, seed=42):
        rng = np.random.default_rng(seed)
        self.W1 = rng.standard_normal((hidden_dim, in_dim)).astype(np.float32)   * math.sqrt(2.0/in_dim)
        self.b1 = np.zeros(hidden_dim, dtype=np.float32)
        self.W2 = rng.standard_normal((hidden_dim, hidden_dim)).astype(np.float32) * math.sqrt(2.0/hidden_dim)
        self.b2 = np.zeros(hidden_dim, dtype=np.float32)
        self.W3 = rng.standard_normal((n_classes, hidden_dim)).astype(np.float32) * math.sqrt(2.0/hidden_dim)
        self.b3 = np.zeros(n_classes, dtype=np.float32)

        # Adam state
        self.params = [self.W1, self.b1, self.W2, self.b2, self.W3, self.b3]
        self.m  = [np.zeros_like(p) for p in self.params]
        self.v  = [np.zeros_like(p) for p in self.params]
        self.t  = 0

    def forward(self, x):
        # x: (B, 5)
        z1 = x @ self.W1.T + self.b1          # (B, 8)
        a1 = np.maximum(0, z1)                  # ReLU
        z2 = a1 @ self.W2.T + self.b2          # (B, 8)
        a2 = np.maximum(0, z2)                  # ReLU
        z3 = a2 @ self.W3.T + self.b3          # (B, 16)
        # softmax
        z3_s = z3 - z3.max(axis=1, keepdims=True)
        exp_z = np.exp(z3_s)
        probs = exp_z / exp_z.sum(axis=1, keepdims=True)
        # cache for backward
        self._cache = (x, z1, a1, z2, a2, z3, probs)
        return probs

    def loss_and_acc(self, x, y):
        probs = self.forward(x)
        B = len(y)
        log_p = -np.log(probs[np.arange(B), y] + 1e-12)
        loss = log_p.mean()
        acc = (probs.argmax(axis=1) == y).mean()
        return loss, acc

    def backward(self, y, lr=1e-3, beta1=0.9, beta2=0.999, eps=1e-8):
        x, z1, a1, z2, a2, z3, probs = self._cache
        B = len(y)
        self.t += 1

        # dL/dz3
        dz3 = probs.copy()
        dz3[np.arange(B), y] -= 1
        dz3 /= B

        dW3 = dz3.T @ a2          # (16, 8)
        db3 = dz3.sum(axis=0)     # (16,)
        da2 = dz3 @ self.W3       # (B, 8)

        dz2 = da2 * (z2 > 0)     # ReLU backward
        dW2 = dz2.T @ a1          # (8, 8)
        db2 = dz2.sum(axis=0)     # (8,)
        da1 = dz2 @ self.W2       # (B, 8)

        dz1 = da1 * (z1 > 0)     # ReLU backward
        dW1 = dz1.T @ x           # (8, 5)
        db1 = dz1.sum(axis=0)     # (8,)

        grads = [dW1, db1, dW2, db2, dW3, db3]

        # Adam update
        for i, (p, g) in enumerate(zip(self.params, grads)):
            self.m[i] = beta1 * self.m[i] + (1 - beta1) * g
            self.v[i] = beta2 * self.v[i] + (1 - beta2) * g**2
            m_hat = self.m[i] / (1 - beta1**self.t)
            v_hat = self.v[i] / (1 - beta2**self.t)
            p -= lr * m_hat / (np.sqrt(v_hat) + eps)

    def param_count(self):
        return sum(p.size for p in self.params)

    def get_weights(self):
        return {
            "W1": self.W1.copy(), "b1": self.b1.copy(),
            "W2": self.W2.copy(), "b2": self.b2.copy(),
            "W3": self.W3.copy(), "b3": self.b3.copy(),
        }


# ─────────────────────────────────────────────
# 6. Training loops
# ─────────────────────────────────────────────
def train_pytorch(X_tr, y_tr, X_val, y_val, X_te, y_te,
                  hidden_dim, n_classes, lr, batch_size, epochs, seed):
    set_seed(seed)
    model = TinyMLP(in_dim=5, hidden_dim=hidden_dim, n_classes=n_classes)
    optimizer = optim.Adam(model.parameters(), lr=lr)
    criterion = nn.CrossEntropyLoss()

    Xtr = torch.from_numpy(X_tr).float()
    ytr = torch.from_numpy(y_tr).long()
    Xval = torch.from_numpy(X_val).float()
    yval = torch.from_numpy(y_val).long()
    Xte  = torch.from_numpy(X_te).float()
    yte  = torch.from_numpy(y_te).long()

    train_ds = TensorDataset(Xtr, ytr)
    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True,
                               num_workers=0, drop_last=False)

    best_val_loss = float("inf")
    patience = 5
    no_improve = 0
    loss_curve = []
    early_stopped = False

    t_start = time.time()

    for epoch in range(1, epochs + 1):
        model.train()
        running_loss = 0.0
        correct = 0
        total = 0
        for Xb, yb in train_loader:
            optimizer.zero_grad()
            logits = model(Xb)
            loss = criterion(logits, yb)
            loss.backward()
            optimizer.step()
            running_loss += loss.item() * len(yb)
            correct += (logits.argmax(dim=1) == yb).sum().item()
            total += len(yb)

        train_loss = running_loss / total
        train_acc  = correct / total

        # Validation
        model.eval()
        with torch.no_grad():
            val_logits = model(Xval)
            val_loss = criterion(val_logits, yval).item()
            val_acc  = (val_logits.argmax(dim=1) == yval).float().mean().item()

        loss_curve.append({
            "epoch": epoch,
            "train_loss": round(train_loss, 6),
            "val_loss":   round(val_loss, 6),
            "train_acc":  round(train_acc, 6),
            "val_acc":    round(val_acc, 6),
        })

        elapsed = time.time() - t_start
        print(f"[Epoch {epoch:3d}/{epochs}] "
              f"train_loss={train_loss:.4f} train_acc={train_acc:.4f} "
              f"val_loss={val_loss:.4f} val_acc={val_acc:.4f} "
              f"elapsed={elapsed:.1f}s")

        # Early stopping
        if val_loss < best_val_loss - 1e-6:
            best_val_loss = val_loss
            no_improve = 0
            # Save best weights
            best_state = {k: v.detach().numpy().copy()
                          for k, v in model.state_dict().items()}
        else:
            no_improve += 1
            if no_improve >= patience:
                print(f"[EARLY STOP] No improvement for {patience} epochs.")
                early_stopped = True
                break

    training_time = time.time() - t_start

    # Restore best weights
    if "best_state" in dir():
        model.load_state_dict(
            {k: torch.from_numpy(v) for k, v in best_state.items()})

    # Test accuracy
    model.eval()
    with torch.no_grad():
        te_logits = model(Xte)
        test_acc = (te_logits.argmax(dim=1) == yte).float().mean().item()
        # Confusion matrix (top-5 classes for space)
        te_pred = te_logits.argmax(dim=1).numpy()
        te_true = yte.numpy()

    # Confusion matrix 16x16
    cm = np.zeros((16, 16), dtype=int)
    for t_, p_ in zip(te_true, te_pred):
        cm[int(t_)][int(p_)] += 1

    # Extract numpy weights
    sd = model.state_dict()
    # net.0.weight, net.0.bias, net.2.weight, net.2.bias, net.4.weight, net.4.bias
    weights = {
        "W1": sd["net.0.weight"].numpy().copy(),
        "b1": sd["net.0.bias"].numpy().copy(),
        "W2": sd["net.2.weight"].numpy().copy(),
        "b2": sd["net.2.bias"].numpy().copy(),
        "W3": sd["net.4.weight"].numpy().copy(),
        "b3": sd["net.4.bias"].numpy().copy(),
    }
    pc = count_params_torch(model)

    return (loss_curve, weights, pc, training_time, early_stopped,
            loss_curve[-1]["train_loss"], loss_curve[-1]["val_loss"],
            loss_curve[-1]["train_acc"], loss_curve[-1]["val_acc"],
            float(test_acc), cm.tolist())


def train_numpy(X_tr, y_tr, X_val, y_val, X_te, y_te,
                hidden_dim, n_classes, lr, batch_size, epochs, seed):
    set_seed(seed)
    model = NumpyMLP(in_dim=5, hidden_dim=hidden_dim, n_classes=n_classes, seed=seed)

    n_train = len(X_tr)
    best_val_loss = float("inf")
    patience = 5
    no_improve = 0
    loss_curve = []
    early_stopped = False
    best_weights = None

    t_start = time.time()

    for epoch in range(1, epochs + 1):
        # Shuffle training data
        perm = np.random.permutation(n_train)
        X_sh = X_tr[perm]
        y_sh = y_tr[perm]

        running_loss = 0.0
        correct = 0
        for start in range(0, n_train, batch_size):
            Xb = X_sh[start:start+batch_size]
            yb = y_sh[start:start+batch_size]
            probs = model.forward(Xb)
            B = len(yb)
            log_p = -np.log(probs[np.arange(B), yb] + 1e-12)
            running_loss += log_p.sum()
            correct += (probs.argmax(axis=1) == yb).sum()
            model.backward(yb, lr=lr)

        train_loss = running_loss / n_train
        train_acc  = correct / n_train

        val_loss, val_acc = model.loss_and_acc(X_val, y_val)

        loss_curve.append({
            "epoch": epoch,
            "train_loss": float(round(train_loss, 6)),
            "val_loss":   float(round(val_loss, 6)),
            "train_acc":  float(round(train_acc, 6)),
            "val_acc":    float(round(val_acc, 6)),
        })

        elapsed = time.time() - t_start
        print(f"[Epoch {epoch:3d}/{epochs}] "
              f"train_loss={train_loss:.4f} train_acc={float(train_acc):.4f} "
              f"val_loss={val_loss:.4f} val_acc={float(val_acc):.4f} "
              f"elapsed={elapsed:.1f}s")

        if val_loss < best_val_loss - 1e-6:
            best_val_loss = val_loss
            no_improve = 0
            best_weights = model.get_weights()
        else:
            no_improve += 1
            if no_improve >= patience:
                print(f"[EARLY STOP] No improvement for {patience} epochs.")
                early_stopped = True
                break

    training_time = time.time() - t_start

    # Restore best weights
    if best_weights:
        model.W1[:] = best_weights["W1"]
        model.b1[:] = best_weights["b1"]
        model.W2[:] = best_weights["W2"]
        model.b2[:] = best_weights["b2"]
        model.W3[:] = best_weights["W3"]
        model.b3[:] = best_weights["b3"]

    # Test accuracy
    probs_te = model.forward(X_te)
    te_pred = probs_te.argmax(axis=1)
    test_acc = (te_pred == y_te).mean()

    # Confusion matrix 16x16
    cm = np.zeros((16, 16), dtype=int)
    for t_, p_ in zip(y_te, te_pred):
        cm[int(t_)][int(p_)] += 1

    final = loss_curve[-1]
    return (loss_curve, model.get_weights(), model.param_count(), training_time,
            early_stopped,
            final["train_loss"], final["val_loss"],
            final["train_acc"], final["val_acc"],
            float(test_acc), cm.tolist())


# ─────────────────────────────────────────────
# 7. Main
# ─────────────────────────────────────────────
def main():
    args = parse_args()
    set_seed(args.seed)

    # --- Load data ---
    X, y, subset_rows = load_data(args.dataset, args.max_rows, args.seed)

    # --- Class distribution ---
    unique, counts = np.unique(y, return_counts=True)
    class_dist = {int(u): int(c) for u, c in zip(unique, counts)}
    print(f"[DATA] Class distribution: {class_dist}")

    # --- Split ---
    X_tr, y_tr, X_val, y_val, X_te, y_te = split_data(X, y, args.seed)
    print(f"[SPLIT] Train={len(X_tr):,} Val={len(X_val):,} Test={len(X_te):,}")

    n_classes = 16
    framework = "pytorch" if HAS_TORCH else "numpy"

    # --- Train ---
    if HAS_TORCH:
        (loss_curve, weights, param_count, training_time, early_stopped,
         final_train_loss, final_val_loss,
         final_train_acc, final_val_acc,
         final_test_acc, cm) = train_pytorch(
            X_tr, y_tr, X_val, y_val, X_te, y_te,
            args.hidden_dim, n_classes, args.lr, args.batch_size, args.epochs, args.seed)
    else:
        (loss_curve, weights, param_count, training_time, early_stopped,
         final_train_loss, final_val_loss,
         final_train_acc, final_val_acc,
         final_test_acc, cm) = train_numpy(
            X_tr, y_tr, X_val, y_val, X_te, y_te,
            args.hidden_dim, n_classes, args.lr, args.batch_size, args.epochs, args.seed)

    epochs_completed = len(loss_curve)

    print(f"\n[RESULT] framework={framework}")
    print(f"[RESULT] epochs_completed={epochs_completed}, early_stopped={early_stopped}")
    print(f"[RESULT] final_train_loss={final_train_loss:.4f}, final_val_loss={final_val_loss:.4f}")
    print(f"[RESULT] final_train_acc={final_train_acc:.4f}, final_val_acc={final_val_acc:.4f}")
    print(f"[RESULT] final_test_acc={final_test_acc:.4f}")
    print(f"[RESULT] param_count={param_count}")
    print(f"[RESULT] training_time_sec={training_time:.1f}")

    # Verify param count
    assert param_count < 2000, f"param_count={param_count} exceeds 2000!"

    # Check for NaN in weights
    for k, w in weights.items():
        if np.isnan(w).any():
            print(f"[WARN] NaN detected in weight {k}!")

    # ─── Save model ───
    os.makedirs(os.path.dirname(os.path.abspath(args.output)), exist_ok=True)

    model_dict = {
        "arch": "5-8-8-16",
        "weights": weights,
        "activation": "relu",
        "param_count": param_count,
        "input_features": ["cbr_global", "n_neighbors", "v_norm",
                           "dt_since_last_cam", "cbr_smoothed"],
        "action_grid": "16 actions (T_GenCam × p_tx)",
        "seed": args.seed,
    }
    with open(args.output, "wb") as f:
        pickle.dump(model_dict, f, protocol=4)

    pkl_size = os.path.getsize(args.output)
    print(f"[SAVE] Model saved to {args.output} ({pkl_size} bytes)")
    assert pkl_size < 10_240, f"pkl size {pkl_size} exceeds 10KB!"

    # ─── Save log ───
    hyperparams = {
        "lr": args.lr,
        "batch_size": args.batch_size,
        "epochs": args.epochs,
        "hidden_dim": args.hidden_dim,
        "seed": args.seed,
    }
    if subset_rows < 9_195_823:
        hyperparams["subset_rows"] = subset_rows

    log_dict = {
        "framework": framework,
        "epochs_completed": epochs_completed,
        "final_train_loss": round(final_train_loss, 6),
        "final_val_loss":   round(final_val_loss, 6),
        "final_train_acc":  round(final_train_acc, 6),
        "final_val_acc":    round(final_val_acc, 6),
        "final_test_acc":   round(final_test_acc, 6),
        "param_count": param_count,
        "training_time_sec": round(training_time, 2),
        "early_stopped": early_stopped,
        "loss_curve": loss_curve,
        "confusion_matrix_test_top5": cm,
        "class_distribution_train": class_dist,
        "hyperparams": hyperparams,
    }

    os.makedirs(os.path.dirname(os.path.abspath(args.log)), exist_ok=True)
    with open(args.log, "w") as f:
        json.dump(log_dict, f, indent=2)
    print(f"[SAVE] Log saved to {args.log}")

    # ─── Validation signals ───
    print("\n=== VALIDATION SIGNALS ===")
    val_ok = final_val_acc > 0.45
    print(f"  val_acc={final_val_acc:.4f} > 0.45? {val_ok}")
    print(f"  param_count={param_count} < 2000? {param_count < 2000}")
    print(f"  pkl_size={pkl_size} < 10240? {pkl_size < 10240}")
    nan_free = all(not np.isnan(w).any() for w in weights.values())
    print(f"  NaN-free weights? {nan_free}")
    gap = final_train_acc - final_val_acc
    print(f"  train-val gap={gap:.4f} (warn if >0.25)")
    if gap > 0.25:
        print("[WARN] Large train-val gap detected!")
    if final_val_acc < 0.15:
        print("[WARN] val_acc < 0.15, very low accuracy!")


if __name__ == "__main__":
    main()
