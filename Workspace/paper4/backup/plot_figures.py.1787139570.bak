def generate_all_figures(out_dir=VIS_DIR):
    print("=== Generating All Figures (PDF & PNG 300 DPI) ===")
    plot_ablation_study(out_dir)
    plot_reward_convergence(out_dir)
    plot_tsne_clustering(out_dir)
    plot_moe_routing(out_dir)
    plot_cbr_trace(out_dir)
    plot_pdr_vs_density(out_dir)
    plot_aoi_vs_density(out_dir)
    plot_pdr_vs_distance(out_dir)
    plot_aoi_vs_distance(out_dir)
    print("=== Figure Generation Completed ===")


if __name__ == "__main__":
    generate_all_figures()
