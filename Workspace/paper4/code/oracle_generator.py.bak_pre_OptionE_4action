def parse_args():
    p = argparse.ArgumentParser(
        description=(
            "Oracle label generator for TinyMLP-AI-DCC (E4-impl-1). "
            "3-term cost: alpha*AoI_norm + beta*|CBR-target| + gamma*E_tx_norm. "
            "Option C: default grid_size=9 (3x3 right-sized main scheme); "
            "16/25 supported for SA2 ablation."
        )
    )
    p.add_argument("--duration_steps", type=int,   default=6000,
                   help="Simulation steps (default: 6000 = 600s)")
    # [PATCH 2026-05-14] --alpha default changed 0.5 → 0.3; --beta and --gamma added
    p.add_argument("--alpha",  type=float, default=0.3,
                   help="AoI weight in 3-term cost (default: 0.3)")
    p.add_argument("--beta",   type=float, default=0.6,
                   help="CBR target tracking weight in 3-term cost (default: 0.6)")
    p.add_argument("--gamma",  type=float, default=0.1,
                   help="TX energy weight in 3-term cost (default: 0.1)")
    p.add_argument("--cbr_target", type=float, default=0.55,
                   help="Target CBR (default: 0.55)")
    p.add_argument("--seed",   type=int,   default=42,
                   help="Random seed (default: 42)")
    p.add_argument("--warmup_s", type=float, default=30.0,
                   help="Warm-up period in seconds before collecting (default: 30)")
    p.add_argument("--grid_size", type=int, default=9, choices=[9, 16, 25],
                   help="Action grid size: 9 (3x3 main, default) | 16 (4x4 ablation) | 25 (5x5 ablation)")
    p.add_argument("--output", type=str,
                   default="/home/imnyj/papers/paper4/paper/data/oracle_dataset.csv",
                   help="Output CSV path")
    return p.parse_args()


if __name__ == "__main__":
    args = parse_args()
    configure_grid(args.grid_size)
    print(f"[oracle] Active grid: {args.grid_size}-action "
          f"({len(GRID_PRESETS[args.grid_size]['T'])}x{len(GRID_PRESETS[args.grid_size]['P'])}) "
          f"T={T_GENCAM_GRID_S} P={P_TX_GRID}")
    run_oracle(
        duration_steps = args.duration_steps,
        alpha          = args.alpha,
        beta           = args.beta,
        gamma          = args.gamma,
        cbr_target     = args.cbr_target,
        seed           = args.seed,
        warmup_s       = args.warmup_s,
        output_csv     = args.output,
    )
