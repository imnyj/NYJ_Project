# ── libsumo ──────────────────────────────────────────────────────────────────
import libsumo

# ── local imports ─────────────────────────────────────────────────────────────
_sim_dir = os.path.dirname(os.path.abspath(__file__))
if _sim_dir not in sys.path:
    sys.path.insert(0, _sim_dir)

from etsi_cam_layer import ETSICAMLayer, T_GENCAM_MIN, T_GENCAM_MAX, dbm_to_linear

# ─────────────────────────────────────────────────────────────────────────────
# Constants (mirror sim_engine.py)
# ─────────────────────────────────────────────────────────────────────────────
SUMOCFG_PATH  = "/home/imnyj/SumoNetSim1.1.5/src/sumo/generated.sumocfg"
STEP_LENGTH   = 0.1          # 100 ms per simulation step
COMM_RANGE_M  = 300.0        # 802.11p nominal range (m)

# ── Cost function version metadata ───────────────────────────────────────────
COST_FUNCTION_VERSION = "3term_v3_9action_main"

# ── Action grid presets (Option C — 9-action main + SA2 ablation 16/25) ──────
# [PATCH 2026-05-14] Default scheme changed 16-action → 9-action (3×3).
# Reason: E4-2-redo3 majority-class collapse confirmed 16-grid over-parameterized
# (only 4 of 16 actions Pareto-non-dominated). Per idea_spec C3 reframe, 9-action
# becomes the main right-sized scheme; 16 and 25 are kept for SA2 ablation.
# Selection at runtime via GRID_SIZE module var (default 9) or --grid_size CLI.
#
# P_TX values are ETSI EN 302 663 / TS 102 687 compliant ([0, +30] dBm range).

GRID_PRESETS: Dict[int, Dict[str, List[float]]] = {
    9:  {"T": [0.1, 0.3, 1.0],
         "P": [0.0, 15.0, 30.0]},
    16: {"T": [0.1, 0.2, 0.5, 1.0],
         "P": [0.0, 10.0, 20.0, 30.0]},
    25: {"T": [0.1, 0.2, 0.4, 0.7, 1.0],
         "P": [0.0, 7.5, 15.0, 22.5, 30.0]},
}

# Default grid (9-action main scheme). Override via configure_grid() or CLI.
GRID_SIZE: int = 9
T_GENCAM_GRID_S: List[float] = GRID_PRESETS[GRID_SIZE]["T"]   # seconds
P_TX_GRID:       List[float] = GRID_PRESETS[GRID_SIZE]["P"]   # dBm

# Alias for external imports / sanity checks
P_TX_GRID_DBM = P_TX_GRID  # kept for backward compatibility

# Build flat action list: action_idx = row*|P| + col
ACTIONS: List[Tuple[float, float]] = [
    (t, p)
    for t in T_GENCAM_GRID_S
    for p in P_TX_GRID
]  # GRID_SIZE entries, index 0..GRID_SIZE-1
N_ACTIONS: int = len(ACTIONS)


def configure_grid(grid_size: int) -> None:
    """Reconfigure action grid at runtime (used by --grid_size CLI).

    Updates module-level T_GENCAM_GRID_S, P_TX_GRID, ACTIONS, N_ACTIONS,
    GRID_SIZE so all downstream code (compute_cost, run_oracle, write_meta_json)
    sees the new grid. Must be called BEFORE run_oracle().
    """
    global GRID_SIZE, T_GENCAM_GRID_S, P_TX_GRID, P_TX_GRID_DBM, ACTIONS, N_ACTIONS
    if grid_size not in GRID_PRESETS:
        raise ValueError(
            f"grid_size must be one of {sorted(GRID_PRESETS.keys())}, got {grid_size}"
        )
    GRID_SIZE = grid_size
    T_GENCAM_GRID_S = GRID_PRESETS[grid_size]["T"]
    P_TX_GRID       = GRID_PRESETS[grid_size]["P"]
    P_TX_GRID_DBM   = P_TX_GRID
    ACTIONS         = [(t, p) for t in T_GENCAM_GRID_S for p in P_TX_GRID]
    N_ACTIONS       = len(ACTIONS)

# Action index mapping comment (for cross-reference with old grid):
# OLD grid P_TX = [-10, 0, +10, +20] dBm:
#   old action  0: (T=0.1, P=-10)   new action  0: (T=0.1, P=0)
#   old action  1: (T=0.1, P= 0)   new action  1: (T=0.1, P=10)
#   old action  2: (T=0.1, P=+10)  new action  2: (T=0.1, P=20)
#   old action  3: (T=0.1, P=+20)  new action  3: (T=0.1, P=30)
#   ... (same T row structure, P column shifted by +10 dBm)
#   old collapse: actions 0/3/7/11 were dominant under 2-term cost
#   new mapping: action 15 (T=1.0, P=+30) is new max-energy/max-interval action

# ── 802.11p TX params (for CBR_pred normalisation) ───────────────────────────
CAM_PACKET_BYTES = 280
DATA_RATE_BPS    = 3_000_000
TX_DURATION_S    = (CAM_PACKET_BYTES * 8) / DATA_RATE_BPS  # ~0.747 ms

# ── EMA smoothing ─────────────────────────────────────────────────────────────
EMA_LAMBDA = 0.5   # for cbr_smoothed_local (§5 spec)

# ── State-exploration policy (PATCH 2026-05-14) ───────────────────────────────
# Period (in simulation steps) at which each vehicle's (prev_T_GenCam, prev_p_tx)
# is randomly resampled from the active action grid (9/16/25 depending on
# --grid_size). With STEP_LENGTH=0.1 s and EXPLORE_RESAMPLE_STEPS=50, each
# vehicle changes its exploration prev-action every 5 s — sufficient for the
# cost function to observe diverse states. Without this, BL-A converges to a
# single operating point and labels collapse (see E4-1-redo/redo2/redo3).
EXPLORE_RESAMPLE_STEPS = 50

# ── State normalisation constants ─────────────────────────────────────────────
V_NORM_SCALE   = 25.0   # m/s  (§5)
N_NORM_SCALE   = 50.0   # vehicles (§5)
DT_NORM_SCALE  = 1.0    # s (§5)

# ─────────────────────────────────────────────────────────────────────────────
# Per-vehicle local state (for state 5D extraction)
# ─────────────────────────────────────────────────────────────────────────────
class VehicleOracleState:
    """Tracks per-vehicle oracle features between steps.

    [PATCH 2026-05-14 — state-exploration] Adds an explicit prev-action
    exploration policy that randomly resamples (prev_T_GenCam, prev_p_tx)
    every EXPLORE_RESAMPLE_STEPS simulation steps. This is the standard
    behavior-policy randomization technique for supervised-from-rollouts
    (DAgger / behavior cloning) — it lets the oracle expose diverse
    (state, prev_action) pairs without modifying the underlying CAM
    physics of BL-A. The actual ETSI CAM transmissions still use BL-A
    parameters; only the *labeled* prev_T/prev_p that flow into the
    cost function and CSV features are randomized.
    """

    def __init__(self, vid: str, rng: random.Random):
        self.vid             = vid
        self.last_cam_time   = 0.0    # sim_time of last outgoing CAM
        self.cbr_smoothed    = 0.0    # EMA of cbr_global at each step
        # Exploration prev-action — randomized at init and every EXPLORE_RESAMPLE_STEPS
        self.prev_T_GenCam   = rng.choice(T_GENCAM_GRID_S)
        self.prev_p_tx       = rng.choice(P_TX_GRID)
        # Next sim_time at which exploration policy resamples prev_T/prev_p
        self._next_resample_step = 0

    def maybe_resample(self, step: int, rng: random.Random,
                       resample_every: int = 50):
        """Re-randomize prev_T_GenCam and prev_p_tx every `resample_every`
        steps (default 50 = 5.0 s at 100 ms step). This guarantees that
        across the full simulation the state space spans the entire
        active action grid uniformly (grid size = GRID_SIZE).
        """
        if step >= self._next_resample_step:
            self.prev_T_GenCam = rng.choice(T_GENCAM_GRID_S)
            self.prev_p_tx     = rng.choice(P_TX_GRID)
            self._next_resample_step = step + resample_every

    def update_ema(self, cbr_global: float):
        """Update EMA-smoothed CBR (lambda=0.5)."""
        self.cbr_smoothed = (
            EMA_LAMBDA * cbr_global
            + (1.0 - EMA_LAMBDA) * self.cbr_smoothed
        )


# ─────────────────────────────────────────────────────────────────────────────
# Cost function — 3-term (PATCHED 2026-05-14)
# ─────────────────────────────────────────────────────────────────────────────
def compute_cost(
    t_act: float,
    p_dbm: float,
    state: dict,
    alpha: float = 0.3,
    beta:  float = 0.6,
    gamma: float = 0.1,
    cbr_target: float = 0.55,
) -> float:
    """
    3-term combined cost for oracle label generation.

    J(t, p | s) = alpha * AoI_norm
                + beta  * |CBR_pred(t, p, s) - cbr_target|
                + gamma * E_tx_norm(p)

    Where:
      AoI_norm    = t_act / T_MAX           (T_MAX = 1.0 s)
      CBR_pred    = cbr_global * (t_current / t_act) * (p_lin / p_current_lin)
      E_tx_norm   = p_lin / p_lin_max       (p_lin_max = 10^(30/10) = 1000 mW)

    NOTE: Weights alpha, beta, gamma are INDEPENDENT (no sum-to-1 constraint).
          The old (1-alpha) pattern has been removed per idea_spec §4.3.

    Args:
      t_act:      T_GenCam candidate action (s), e.g. 0.1 to 1.0
      p_dbm:      p_tx candidate action (dBm), e.g. 0, 10, 20, 30
      state:      dict with keys: cbr_global, prev_T_GenCam, prev_p_tx
      alpha:      AoI weight (default 0.3)
      beta:       CBR target tracking weight (default 0.6)
      gamma:      TX energy weight (default 0.1)
      cbr_target: target CBR (default 0.55)

    Returns:
      scalar cost value
    """
    # Avoid division by zero
    t_act    = max(t_act,    1e-6)
    t_current = max(state.get("prev_T_GenCam", T_GENCAM_MIN), 1e-6)

    # ── AoI normalisation ─────────────────────────────────────────────────────
    T_MAX    = 1.0  # T_GENCAM_MAX per ETSI (seconds)
    aoi_norm = t_act / T_MAX   # ∈ [0.1, 1.0]

    # ── CBR prediction ────────────────────────────────────────────────────────
    cbr_global    = state.get("cbr_global", 0.0)
    p_current_dbm = state.get("prev_p_tx", 20.0)

    p_action_lin  = dbm_to_linear(p_dbm)
    p_current_lin = max(dbm_to_linear(p_current_dbm), 1e-12)

    cbr_pred = (
        cbr_global
        * (t_current / t_act)
        * (p_action_lin / p_current_lin)
    )
    cbr_pred = max(0.0, min(cbr_pred, 1.0))

    # ── TX energy normalisation ───────────────────────────────────────────────
    # p_lin_max = 10^(+30/10) = 1000 mW  (for P_TX_GRID[-1] = +30 dBm)
    p_lin_max  = 10.0 ** (P_TX_GRID[-1] / 10.0)   # = 1000.0 mW
    e_tx_norm  = p_action_lin / p_lin_max            # ∈ [0.001, 1.0] for {0,+10,+20,+30}
    # e_tx_norm values: 0 dBm→0.001, 10 dBm→0.01, 20 dBm→0.1, 30 dBm→1.0

    # ── 3-term combined cost ──────────────────────────────────────────────────
    # NOTE: No sum-to-1 normalisation; each weight is independent.
    cost = (
        alpha * aoi_norm
        + beta  * abs(cbr_pred - cbr_target)
        + gamma * e_tx_norm
    )
    return cost


# ─────────────────────────────────────────────────────────────────────────────
# Legacy wrapper — kept for compatibility; internally calls compute_cost()
# ─────────────────────────────────────────────────────────────────────────────
def evaluate_action(
    t_action: float,
    p_action_dbm: float,
    cbr_global: float,
    t_current: float,
    p_current_dbm: float,
    cbr_target: float,
    alpha: float,
    beta: float  = 0.6,
    gamma: float = 0.1,
) -> float:
    """
    Legacy wrapper around compute_cost() for backward compatibility.
    Constructs the state dict and delegates to compute_cost().
    """
    state = {
        "cbr_global":    cbr_global,
        "prev_T_GenCam": t_current,
        "prev_p_tx":     p_current_dbm,
    }
    return compute_cost(
        t_act      = t_action,
        p_dbm      = p_action_dbm,
        state      = state,
        alpha      = alpha,
        beta       = beta,
        gamma      = gamma,
        cbr_target = cbr_target,
    )


# ─────────────────────────────────────────────────────────────────────────────
# Metadata writer (oracle dataset meta JSON)
# ─────────────────────────────────────────────────────────────────────────────
def write_meta_json(output_csv: str, alpha: float, beta: float, gamma: float,
                    cbr_target: float) -> str:
    """
    Write dataset metadata JSON alongside the CSV.
    Records weights, grids, cost function version, and timestamp.
    """
    meta_path = output_csv.replace(".csv", "_meta.json")
    meta = {
        "cost_function_version": COST_FUNCTION_VERSION,
        "weights": {
            "alpha": alpha,
            "beta":  beta,
            "gamma": gamma,
        },
        "cbr_target":    cbr_target,
        "grid_size":     GRID_SIZE,
        "p_tx_grid":     P_TX_GRID,
        "t_grid":        T_GENCAM_GRID_S,
        "n_actions":     len(ACTIONS),
        "generated_at":  time.strftime("%Y-%m-%dT%H:%M:%S"),
        "note": (
            "P_TX_GRID = ETSI EN 302 663 compliant (within [0,+30] dBm). "
            "Cost: 3-term (alpha*AoI_norm + beta*|CBR_pred-target| + gamma*E_tx_norm), "
            "independent weights. "
            "PATCH 2026-05-14: per-vehicle prev-action exploration policy "
            "(VehicleOracleState.maybe_resample every EXPLORE_RESAMPLE_STEPS steps) "
            "injects uniform coverage of (prev_T, prev_p) over the active action grid "
            "to prevent label collapse observed in redo/redo2/redo3. "
            "Option C (2026-05-14): default grid_size=9 (3×3) right-sized main scheme."
        ),
        "explore_resample_steps": EXPLORE_RESAMPLE_STEPS,
    }
    with open(meta_path, "w") as f:
        json.dump(meta, f, indent=2)
    print(f"[oracle] metadata JSON written: {meta_path}")
    return meta_path


# ─────────────────────────────────────────────────────────────────────────────
# Main oracle generation loop
# ─────────────────────────────────────────────────────────────────────────────
def run_oracle(
    duration_steps: int = 6000,
    alpha: float = 0.3,
    beta:  float = 0.6,
    gamma: float = 0.1,
    cbr_target: float = 0.55,
    seed: int = 42,
    warmup_s: float = 30.0,
    snapshot_every_n_steps: int = 1,   # collect at every step (100ms)
    output_csv: str = "/home/imnyj/papers/paper4/paper/data/oracle_dataset.csv",
) -> dict:
    """
    Run BL-A simulation and produce oracle dataset.

    Returns summary dict.
    """
    t_start = time.time()

    # Ensure output directory exists
    os.makedirs(os.path.dirname(output_csv), exist_ok=True)

    # ── Init modules ──────────────────────────────────────────────────────────
    cam_layer = ETSICAMLayer(method="BL-A")
    rng       = random.Random(seed)

    # Per-vehicle oracle state
    oracle_states: Dict[str, VehicleOracleState] = {}

    # CBR history (for compute_cbr approximation)
    cbr_prev = 0.0

    # Action distribution counter
    action_dist = defaultdict(int)

    # Accumulated rows to write
    rows: List[dict] = []
    n_states_collected = 0

    # ── Open CSV ──────────────────────────────────────────────────────────────
    # [PATCH 2026-05-14] Added beta, gamma columns; kept alpha for backward compat
    fieldnames = [
        "vid", "sim_time",
        "cbr_global", "n_neighbors", "v_norm",
        "dt_since_last_cam", "cbr_smoothed",
        "action_idx", "T_GenCam_chosen", "p_tx_chosen",
        "cost", "alpha", "beta", "gamma",
    ]

    csv_file   = open(output_csv, "w", newline="")
    csv_writer = csv.DictWriter(csv_file, fieldnames=fieldnames)
    csv_writer.writeheader()

    # ── Start libsumo ─────────────────────────────────────────────────────────
    libsumo.start([
        "sumo",
        "-c", SUMOCFG_PATH,
        "--step-length", str(STEP_LENGTH),
        "--seed", str(seed),
        "--no-warnings", "true",
        "--no-step-log", "true",
        "--time-to-teleport", "-1",
        "--collision.action", "warn",
    ])

    try:
        step = 0
        while (
            libsumo.simulation.getMinExpectedNumber() > 0
            and step < duration_steps
        ):
            libsumo.simulationStep()
            sim_time = step * STEP_LENGTH
            step    += 1

            # ── Fetch vehicle data ────────────────────────────────────────────
            vehicle_ids = libsumo.vehicle.getIDList()
            if not vehicle_ids:
                continue

            vehicles_data    = []
            vehicle_positions: Dict[str, Tuple[float, float]] = {}

            for vid in vehicle_ids:
                try:
                    x, y  = libsumo.vehicle.getPosition(vid)
                    speed = libsumo.vehicle.getSpeed(vid)
                    heading = libsumo.vehicle.getAngle(vid)
                    accel   = libsumo.vehicle.getAcceleration(vid)
                except Exception:
                    continue
                vehicle_positions[vid] = (x, y)
                vehicles_data.append({
                    "vid":     vid,
                    "x":       x,
                    "y":       y,
                    "speed":   speed,
                    "heading": heading,
                    "accel":   accel,
                    "n_est":   len(vehicle_ids) - 1,
                })

            if not vehicles_data:
                continue

            # ── CAM layer step (BL-A) ─────────────────────────────────────────
            cam_events = cam_layer.step(vehicles_data, sim_time, cbr_prev)

            # ── Compute CBR for this step ─────────────────────────────────────
            n_cams = len(cam_events)
            cbr_global = min(n_cams * TX_DURATION_S / STEP_LENGTH, 1.0)
            cbr_prev   = cbr_global

            # ── Update per-vehicle oracle states ──────────────────────────────
            # Note: cam_events already occurred; update last_cam_time + EMA
            cam_senders = {ev["vid"]: ev for ev in cam_events}

            for vdata in vehicles_data:
                vid = vdata["vid"]
                if vid not in oracle_states:
                    oracle_states[vid] = VehicleOracleState(vid, rng)
                ovs = oracle_states[vid]

                # [PATCH 2026-05-14] Resample exploration prev-action periodically.
                # This guarantees uniform coverage of (prev_T, prev_p) across the
                # active action grid so that the supervised oracle observes diverse
                # (state, prev_action) pairs — required for non-collapsed labels.
                ovs.maybe_resample(step, rng, resample_every=EXPLORE_RESAMPLE_STEPS)

                # EMA update
                ovs.update_ema(cbr_global)

                # Track last_cam_time when this vehicle transmits a CAM.
                # NOTE: prev_T_GenCam / prev_p_tx are now driven by the
                # exploration policy above, NOT by the BL-A CAM event.
                # This is intentional: the labeled state must span the full
                # action grid for behavior cloning to work; BL-A operating
                # point alone collapses prev_T to T_GENCAM_MIN.
                if vid in cam_senders:
                    ovs.last_cam_time = sim_time

            # ── State snapshot & label collection (after warmup) ──────────────
            if sim_time >= warmup_s and (step % snapshot_every_n_steps == 0):

                # Compute n_neighbors for each vehicle (within COMM_RANGE_M)
                n_neighbors_map: Dict[str, int] = {}
                vids_list = list(vehicle_positions.keys())
                for vid in vids_list:
                    px, py = vehicle_positions[vid]
                    cnt = 0
                    for ovid in vids_list:
                        if ovid == vid:
                            continue
                        ox, oy = vehicle_positions[ovid]
                        dist = math.sqrt((px - ox)**2 + (py - oy)**2)
                        if dist <= COMM_RANGE_M:
                            cnt += 1
                    n_neighbors_map[vid] = cnt

                for vdata in vehicles_data:
                    vid   = vdata["vid"]
                    speed = vdata["speed"]

                    ovs = oracle_states[vid]

                    # ── Build state 5D ────────────────────────────────────────
                    cbr_g         = cbr_global
                    n_neigh       = n_neighbors_map.get(vid, 0)
                    n_neigh_norm  = n_neigh / N_NORM_SCALE
                    v_norm        = speed / V_NORM_SCALE
                    dt_since      = (sim_time - ovs.last_cam_time) / DT_NORM_SCALE
                    cbr_smoothed  = ovs.cbr_smoothed

                    # ── Build state dict for compute_cost ─────────────────────
                    state_dict = {
                        "cbr_global":    cbr_g,
                        "prev_T_GenCam": ovs.prev_T_GenCam,
                        "prev_p_tx":     ovs.prev_p_tx,
                    }

                    # ── Grid search over active action grid (N_ACTIONS) ───────
                    best_idx  = 0
                    best_cost = float("inf")

                    for a_idx, (t_act, p_act) in enumerate(ACTIONS):
                        c = compute_cost(
                            t_act      = t_act,
                            p_dbm      = p_act,
                            state      = state_dict,
                            alpha      = alpha,
                            beta       = beta,
                            gamma      = gamma,
                            cbr_target = cbr_target,
                        )
                        if c < best_cost:
                            best_cost = c
                            best_idx  = a_idx

                    best_t, best_p = ACTIONS[best_idx]

                    row = {
                        "vid":               vid,
                        "sim_time":          round(sim_time, 2),
                        "cbr_global":        round(cbr_g, 6),
                        "n_neighbors":       round(n_neigh_norm, 6),
                        "v_norm":            round(v_norm, 6),
                        "dt_since_last_cam": round(dt_since, 6),
                        "cbr_smoothed":      round(cbr_smoothed, 6),
                        "action_idx":        best_idx,
                        "T_GenCam_chosen":   best_t,
                        "p_tx_chosen":       best_p,
                        "cost":              round(best_cost, 6),
                        "alpha":             alpha,
                        "beta":              beta,
                        "gamma":             gamma,
                    }
                    csv_writer.writerow(row)
                    action_dist[best_idx] += 1
                    n_states_collected   += 1

            # ── Progress log ─────────────────────────────────────────────────
            if step % 1000 == 0:
                print(f"[oracle] step={step} collected={n_states_collected}")

    finally:
        csv_file.close()
        try:
            libsumo.close()
        except Exception:
            pass

    # ── Write metadata JSON ───────────────────────────────────────────────────
    write_meta_json(output_csv, alpha, beta, gamma, cbr_target)

    elapsed = time.time() - t_start

    # ── Summary ───────────────────────────────────────────────────────────────
    print(f"\n[oracle] ===== DONE =====")
    print(f"  n_states_collected : {n_states_collected}")
    print(f"  elapsed_sec        : {elapsed:.1f}")
    print(f"  weights            : alpha={alpha}, beta={beta}, gamma={gamma}")
    print(f"  cbr_target         : {cbr_target}")
    print(f"  p_tx_grid          : {P_TX_GRID}")
    print(f"  cost_fn_version    : {COST_FUNCTION_VERSION}")
    print(f"  action_distribution:")
    for idx in range(len(ACTIONS)):
        t_a, p_a = ACTIONS[idx]
        cnt = action_dist.get(idx, 0)
        print(f"    action[{idx:2d}] T={t_a:.1f}s p={p_a:+.0f}dBm -> {cnt:>8d}")
    print(f"  output CSV: {output_csv}")

    return {
        "n_states_collected": n_states_collected,
        "action_distribution": dict(action_dist),
        "elapsed_sec": round(elapsed, 1),
        "output_csv": output_csv,
    }


