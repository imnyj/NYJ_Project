import json
import logging
import math
import os
from typing import Any, Dict, List, Optional, Tuple, Union

import numpy as np
import pandas as pd
import torch

from src.baselines import (
    BASELINE_REGISTRY,
    BaseRLModel,
)
import src.Communications as comm
from src.heuristic_scheduler import HeuristicScheduler
from src.rl_interface import StateVectorizer

# Setup logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("EvaluateHarness")

# Canonical 10 evaluated models
CANONICAL_EVAL_MODELS = [
    "HeuristicScheduler",
    "HybridPPO",
    "HybridSAC",
    "HybridTD3",
    "MAPPO",
    "HyARPPO",
    "MPDQN",
    "PureAoI",
    "DuelingQAoI",
    "SACAoI",
]

MODEL_CATEGORIES = {
    "HeuristicScheduler": "Category 0 (Heuristic)",
    "Heuristic": "Category 0 (Heuristic)",
    "Heuristic-Dynamic": "Category 0 (Heuristic)",
    "HybridPPO": "Category 1 (Basic)",
    "HybridSAC": "Category 1 (Basic)",
    "HybridTD3": "Category 1 (Basic)",
    "MAPPO": "Category 2 (Latest)",
    "HyARPPO": "Category 2 (Latest)",
    "MPDQN": "Category 2 (Latest)",
    "PureAoI": "Category 3 (SOTA AoI)",
    "DuelingQAoI": "Category 3 (SOTA AoI)",
    "SACAoI": "Category 3 (SOTA AoI)",
}

DEFAULT_DENSITIES = [15.0, 25.0, 35.0, 45.0, 55.0]
DEFAULT_SEEDS = [42, 101, 2024, 777, 999]


def normalize_model_name(name: str) -> str:
    """Resolve aliases to canonical model name."""
    clean = name.replace("-", "").replace("_", "").lower()
    if clean in ["heuristicscheduler", "heuristic", "heuristicdynamic", "s25heuristic", "rulebased"]:
        return "HeuristicScheduler"
    if clean in ["hybridppo", "hppo", "ppo"]:
        return "HybridPPO"
    if clean in ["hybridsac", "hsac", "sac"]:
        return "HybridSAC"
    if clean in ["hybridtd3", "htd3", "td3"]:
        return "HybridTD3"
    if clean in ["mappo"]:
        return "MAPPO"
    if clean in ["hyarppo", "hyar"]:
        return "HyARPPO"
    if clean in ["mpdqn", "pdqn"]:
        return "MPDQN"
    if clean in ["pureaoi", "whittle"]:
        return "PureAoI"
    if clean in ["duelingqaoi", "duelingq"]:
        return "DuelingQAoI"
    if clean in ["sacaoi"]:
        return "SACAoI"
    return name


def load_optimal_hparams(csv_path: str) -> Dict[str, Dict[str, Any]]:
    """
    Loads optimal hyperparameters from the HPO best params CSV file.
    Parses JSON strings and casts integer hyperparameters appropriately.
    """
    hparams_by_model: Dict[str, Dict[str, Any]] = {}
    if not os.path.exists(csv_path):
        logger.warning(f"HPO params CSV not found at {csv_path}. Using default hyperparameters.")
        return hparams_by_model

    try:
        df = pd.read_csv(csv_path)
        for _, row in df.iterrows():
            raw_name = str(row.get("model_name", "")).strip()
            canonical_name = normalize_model_name(raw_name)
            
            hparams: Dict[str, Any] = {}
            if "hparams_json" in row and pd.notna(row["hparams_json"]):
                try:
                    hparams = json.loads(str(row["hparams_json"]))
                except Exception:
                    hparams = {}

            # Fallback / merge with individual columns
            for col in df.columns:
                if col in ["model_name", "category", "best_value", "best_trial_number", "hparams_json"]:
                    continue
                val = row.get(col)
                if pd.notna(val) and col not in hparams:
                    hparams[col] = val

            # Type conversions for integer hyperparameters
            int_keys = ["hidden_dim", "embed_dim", "policy_freq"]
            for k in int_keys:
                if k in hparams and hparams[k] is not None:
                    hparams[k] = int(float(hparams[k]))

            hparams_by_model[canonical_name] = hparams
        logger.info(f"Successfully loaded optimal hyperparameters for {len(hparams_by_model)} models from {csv_path}.")
    except Exception as e:
        logger.error(f"Error reading HPO params from {csv_path}: {e}. Proceeding with defaults.")

    return hparams_by_model


def instantiate_model(
    model_name: str,
    hparams: Optional[Dict[str, Any]] = None,
    state_dim: int = 16,
    num_channels: int = 4,
) -> Union[BaseRLModel, HeuristicScheduler]:
    """
    Instantiates an evaluated model (either HeuristicScheduler or one of the 9 Baseline RL models)
    with specified or optimal hyperparameters.
    """
    canonical_name = normalize_model_name(model_name)
    params = dict(hparams) if hparams is not None else {}

    if canonical_name == "HeuristicScheduler":
        # Heuristic Scheduler baseline
        return HeuristicScheduler(
            delta_min=params.get("delta_min", 0.5),
            delta_max=params.get("delta_max", 10.0),
            delta_cruise_steady=params.get("delta_cruise_steady", 3.5),
            delta_cruise_accel=params.get("delta_cruise_accel", 1.5),
            p_high=params.get("p_high", 25.0),
            p_mid=params.get("p_mid", 25.0),
            p_low=params.get("p_low", 20.0),
            num_subchannels=num_channels,
        )

    if canonical_name not in BASELINE_REGISTRY:
        raise ValueError(f"Unknown model name '{model_name}'. Available: {list(BASELINE_REGISTRY.keys())} + HeuristicScheduler")

    model_cls = BASELINE_REGISTRY[canonical_name]
    # Filter valid arguments or pass through kwargs
    return model_cls(state_dim=state_dim, num_channels=num_channels, **params)


class EvalSyntheticVehicle:
    """
    Detailed vehicle agent for benchmark simulation runs.
    Maintains real ground-truth kinematics, TraCI traffic light interactions,
    RSU dead-reckoning extrapolation, and per-vehicle metric logs.
    """

    def __init__(
        self,
        vid: str,
        pos: Tuple[float, float],
        vel: Tuple[float, float],
        dist_to_stopline: float,
        tls_state: str,
        time_to_switch: float,
    ) -> None:
        self.vid = vid
        self.pos = list(pos)
        self.vel = list(vel)
        self.accel = 0.0
        self.dist_to_stopline = dist_to_stopline
        self.tls_state = tls_state
        self.time_to_switch = time_to_switch
        self.last_update_t = 0.0
        self.hat_pos = list(pos)
        self.hat_vel = list(vel)
        self.next_tx_t = 0.0

        # Per-vehicle tracking history
        self.history_errors: List[float] = []
        self.history_aois: List[float] = []
        self.peak_aois: List[float] = []
        self.tx_attempts = 0
        self.tx_fails = 0
        self.tx_powers: List[float] = []

    def speed(self) -> float:
        return math.hypot(self.vel[0], self.vel[1])

    def to_state_dict(
        self,
        current_time: float,
        rsu_pos: Tuple[float, float],
        n_active: int,
        cbr: float,
    ) -> Dict[str, Any]:
        dx = self.pos[0] - rsu_pos[0]
        dy = self.pos[1] - rsu_pos[1]
        dist_rsu = math.hypot(dx, dy)
        spd = self.speed()

        stop_imm = 1.0 if (spd > 2.0 and self.tls_state in ["r", "y"] and self.dist_to_stopline < 35.0) else 0.0
        start_imm = 1.0 if (spd < 1.0 and ((self.tls_state == "r" and self.time_to_switch <= 3.0) or (self.tls_state == "g" and self.dist_to_stopline <= 15.0))) else 0.0

        return {
            "vid": self.vid,
            "pos": tuple(self.pos),
            "vel": tuple(self.vel),
            "speed": spd,
            "accel": self.accel,
            "current_time": current_time,
            "last_update_time": self.last_update_t,
            "dist_to_rsu": dist_rsu,
            "n_active": n_active,
            "cbr": cbr,
            "stop_imminent": stop_imm,
            "start_imminent": start_imm,
            "time_to_switch": self.time_to_switch,
            "dist_to_stopline": self.dist_to_stopline,
            "tls_features": {
                "state": self.tls_state,
                "dist_to_stopline": self.dist_to_stopline,
                "time_to_switch": self.time_to_switch,
                "stop_imminent": stop_imm,
                "start_imminent": start_imm,
            },
        }


def calculate_jains_fairness(values: List[float]) -> float:
    """
    Computes Jain's Fairness Index: J(x) = (sum(x))^2 / (N * sum(x^2)).
    Returns 1.0 if all values are zero or list is empty.
    """
    if not values:
        return 1.0
    n = len(values)
    sum_v = sum(values)
    sum_sq = sum(v ** 2 for v in values)
    if sum_sq <= 1e-12:
        return 1.0
    jain = (sum_v ** 2) / (n * sum_sq)
    return float(np.clip(jain, 0.0, 1.0))


def evaluate_single_run(
    model: Union[BaseRLModel, HeuristicScheduler],
    density: float,
    seed: int,
    n_steps: int = 100,
    dt: float = 0.5,
    rsu_pos: Tuple[float, float] = (0.0, 0.0),
    rsu_range: float = 800.0,
) -> Dict[str, Any]:
    """
    Executes a single benchmark evaluation run for a given model, density, and seed.
    
    Simulates:
    - Multi-vehicle traffic dynamics (density-scaled)
    - Traffic light state transitions & kinematics
    - Hybrid scheduling action decisions (interval Delta, subchannel, power)
    - Rayleigh-fading SINR mutual contention across co-channel transmissions
    - Dead-reckoning state estimation & retrospective tracking error
    - Complete 6 IEEE TWC metrics computation
    """
    rng = np.random.RandomState(seed)
    torch.manual_seed(seed)
    vectorizer = StateVectorizer(rsu_range=rsu_range)

    # Scale number of active vehicles with road density (veh/km) over 1.6km diameter RSU cell
    # e.g., 15 veh/km -> 12 vehs, 25 -> 20 vehs, 35 -> 28 vehs, 45 -> 36 vehs, 55 -> 44 vehs
    n_vehicles = max(4, int(round(density * 0.8)))

    vehicles: List[EvalSyntheticVehicle] = []
    for i in range(n_vehicles):
        angle = rng.uniform(0, 2 * math.pi)
        dist = rng.uniform(40.0, rsu_range * 0.9)
        px = rsu_pos[0] + dist * math.cos(angle)
        py = rsu_pos[1] + dist * math.sin(angle)

        heading = angle + math.pi + rng.uniform(-0.4, 0.4)
        spd = rng.uniform(4.0, 22.0)
        vx = spd * math.cos(heading)
        vy = spd * math.sin(heading)

        dist_stop = rng.uniform(15.0, 450.0)
        tls_state = rng.choice(["g", "g", "r", "y"])
        time_to_switch = rng.uniform(4.0, 35.0)

        v = EvalSyntheticVehicle(
            vid=f"v_{seed}_{i}",
            pos=(px, py),
            vel=(vx, vy),
            dist_to_stopline=dist_stop,
            tls_state=tls_state,
            time_to_switch=time_to_switch,
        )
        # Random initial stagger for transmission schedule
        v.next_tx_t = float(rng.uniform(0.0, 1.5))
        vehicles.append(v)

    current_time = 0.0
    all_inst_errors: List[float] = []
    all_low_speed_errors: List[float] = []
    all_high_speed_errors: List[float] = []
    all_inst_aois: List[float] = []
    all_peak_aois: List[float] = []
    all_tx_powers: List[float] = []
    total_tx_attempts = 0
    total_tx_fails = 0

    for step in range(n_steps):
        current_time += dt
        cbr = min(1.0, float(total_tx_attempts) / max(1.0, float(step + 1) * comm.NUM_SUBCHANNELS * 2.0))

        # 1. Update vehicle kinematics and TLS timers
        for v in vehicles:
            v.time_to_switch = max(0.0, v.time_to_switch - dt)
            if v.time_to_switch <= 0.0:
                if v.tls_state == "g":
                    v.tls_state = "y"
                    v.time_to_switch = 4.0
                elif v.tls_state == "y":
                    v.tls_state = "r"
                    v.time_to_switch = rng.uniform(15.0, 30.0)
                else:
                    v.tls_state = "g"
                    v.time_to_switch = rng.uniform(20.0, 40.0)

            # Move vehicle with acceleration dynamics
            spd = v.speed()
            if v.tls_state == "r" and v.dist_to_stopline < 25.0 and spd > 1.0:
                v.accel = -3.0
                new_spd = max(0.0, spd + v.accel * dt)
                factor = new_spd / max(1e-4, spd)
                v.vel[0] *= factor
                v.vel[1] *= factor
            elif v.tls_state == "g" and spd < 16.0:
                v.accel = 2.0
                new_spd = min(24.0, spd + v.accel * dt)
                factor = new_spd / max(1e-4, spd)
                v.vel[0] *= factor
                v.vel[1] *= factor
            else:
                v.accel = 0.0

            v.pos[0] += v.vel[0] * dt
            v.pos[1] += v.vel[1] * dt
            v.dist_to_stopline = max(0.0, v.dist_to_stopline - v.speed() * dt)

            # Calculate instantaneous tracking error
            extrap_x = v.hat_pos[0] + v.hat_vel[0] * (current_time - v.last_update_t)
            extrap_y = v.hat_pos[1] + v.hat_vel[1] * (current_time - v.last_update_t)
            inst_err = math.hypot(v.pos[0] - extrap_x, v.pos[1] - extrap_y)
            aoi = current_time - v.last_update_t

            v.history_errors.append(inst_err)
            v.history_aois.append(aoi)
            all_inst_errors.append(inst_err)
            all_inst_aois.append(aoi)

            if spd < 2.0:
                all_low_speed_errors.append(inst_err)
            else:
                all_high_speed_errors.append(inst_err)

        # 2. Identify ready transmissions & invoke model decision
        transmitting_vehicles: List[Tuple[EvalSyntheticVehicle, float, int, float]] = []

        for v in vehicles:
            if current_time >= v.next_tx_t:
                st_dict = v.to_state_dict(current_time, rsu_pos, len(vehicles), cbr)

                # Record peak AoI sample at transmission trigger instant
                peak_aoi_val = current_time - v.last_update_t
                v.peak_aois.append(peak_aoi_val)
                all_peak_aois.append(peak_aoi_val)

                if isinstance(model, HeuristicScheduler):
                    grant = model.decide_grant(v.vid, st_dict)
                    delta, ch, p = grant
                else:
                    s_vec = vectorizer.vectorize_from_dict(st_dict, rsu_pos)
                    with torch.no_grad():
                        grant, _, _ = model.select_action(s_vec, deterministic=True)
                    delta, ch, p = grant

                # Bound check and sanitize actions
                delta = float(np.clip(delta, 0.5, 10.0))
                ch = int(np.clip(ch, 0, comm.NUM_SUBCHANNELS - 1))
                p = float(np.clip(p, 20.0, 30.0))

                transmitting_vehicles.append((v, delta, ch, p))
                v.tx_powers.append(p)
                all_tx_powers.append(p)

        # 3. Resolve uplink transmissions with mutual Rayleigh-SINR contention
        if transmitting_vehicles:
            by_channel: Dict[int, List[Tuple[EvalSyntheticVehicle, float, float, float]]] = {}
            for v, delta, ch, p in transmitting_vehicles:
                dist_rsu = math.hypot(v.pos[0] - rsu_pos[0], v.pos[1] - rsu_pos[1])
                by_channel.setdefault(ch, []).append((v, delta, p, dist_rsu))

            for ch, group in by_channel.items():
                comm_group = [(item[0].vid, item[2], item[3]) for item in group]
                succ_probs = comm.judge_uplink(comm_group, num_subchannels=comm.NUM_SUBCHANNELS)

                for v, delta, p, dist_rsu in group:
                    total_tx_attempts += 1
                    v.tx_attempts += 1
                    prob = succ_probs.get(v.vid, 0.0)
                    is_succ = rng.random() < prob

                    if is_succ:
                        # Successful reception: refresh RSU state
                        v.hat_pos = list(v.pos)
                        v.hat_vel = list(v.vel)
                        v.last_update_t = current_time
                    else:
                        total_tx_fails += 1
                        v.tx_fails += 1

                    # Schedule next transmission
                    v.next_tx_t = current_time + delta

    # 4. Compute 6 IEEE TWC Metrics
    mean_aoi = float(np.mean(all_inst_aois)) if all_inst_aois else 0.0
    peak_aoi = float(np.mean(all_peak_aois)) if all_peak_aois else mean_aoi
    if peak_aoi < mean_aoi:
        peak_aoi = mean_aoi

    packet_loss_rate = float(total_tx_fails / max(1, total_tx_attempts))
    mean_err = float(np.mean(all_inst_errors)) if all_inst_errors else 0.0
    max_err = float(np.max(all_inst_errors)) if all_inst_errors else 0.0
    low_spd_err = float(np.mean(all_low_speed_errors)) if all_low_speed_errors else mean_err
    high_spd_err = float(np.mean(all_high_speed_errors)) if all_high_speed_errors else mean_err

    avg_power = float(np.mean(all_tx_powers)) if all_tx_powers else 25.0
    # Total energy in Joules: sum(10^((P_dBm - 30)/10) * t_packet) (1ms packet length)
    total_energy_j = float(sum(10.0 ** ((p - 30.0) / 10.0) * 0.001 for p in all_tx_powers))

    # Per-vehicle means for Jain's Fairness
    per_veh_aois = [float(np.mean(v.history_aois)) if v.history_aois else 1.0 for v in vehicles]
    per_veh_errors = [float(np.mean(v.history_errors)) if v.history_errors else 0.1 for v in vehicles]

    jains_aoi = calculate_jains_fairness(per_veh_aois)
    jains_err = calculate_jains_fairness(per_veh_errors)

    return {
        "density": float(density),
        "seed": int(seed),
        "mean_aoi": round(mean_aoi, 4),
        "peak_aoi": round(peak_aoi, 4),
        "packet_loss_rate": round(packet_loss_rate, 4),
        "mean_error": round(mean_err, 4),
        "max_error": round(max_err, 4),
        "low_speed_error": round(low_spd_err, 4),
        "high_speed_error": round(high_spd_err, 4),
        "avg_tx_power_dbm": round(avg_power, 4),
        "total_energy_joules": round(total_energy_j, 6),
        "jains_fairness_aoi": round(jains_aoi, 4),
        "jains_fairness_err": round(jains_err, 4),
        "tx_attempts": total_tx_attempts,
        "tx_fails": total_tx_fails,
    }


def run_full_benchmark(
    models: Optional[List[str]] = None,
    densities: Optional[List[float]] = None,
    seeds: Optional[List[int]] = None,
    hparams_csv: str = "/home/imnyj/Workspace/paper4/coder/results/hpo/optuna_best_params.csv",
    output_dir: str = "/home/imnyj/Workspace/paper4/coder/results/eval",
    n_steps: int = 100,
) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    """
    Executes the full benchmark evaluation across models, densities, and seeds.
    Generates 3 DataFrames: raw_runs, summary_by_density, and leaderboard.
    """
    target_models = models if models is not None else CANONICAL_EVAL_MODELS
    target_densities = densities if densities is not None else DEFAULT_DENSITIES
    target_seeds = seeds if seeds is not None else DEFAULT_SEEDS

    logger.info(
        f"Starting Benchmark Matrix: {len(target_models)} models x {len(target_densities)} densities x {len(target_seeds)} seeds = {len(target_models) * len(target_densities) * len(target_seeds)} total runs."
    )

    # 1. Load optimal hyperparameters
    hparams_map = load_optimal_hparams(hparams_csv)

    # 2. Run all combinations
    raw_records: List[Dict[str, Any]] = []

    for model_name in target_models:
        canonical_name = normalize_model_name(model_name)
        category = MODEL_CATEGORIES.get(canonical_name, "Baseline")
        hparams = hparams_map.get(canonical_name, {})

        logger.info(f"Evaluating model: {canonical_name} ({category})...")
        model = instantiate_model(canonical_name, hparams)

        for density in target_densities:
            for seed in target_seeds:
                metrics = evaluate_single_run(
                    model=model,
                    density=density,
                    seed=seed,
                    n_steps=n_steps,
                )
                record = {
                    "model_name": canonical_name,
                    "category": category,
                    **metrics,
                }
                raw_records.append(record)

    df_raw = pd.DataFrame(raw_records)

    # 3. Create summary by density (mean across seeds)
    agg_cols = [
        "mean_aoi", "peak_aoi", "packet_loss_rate", "mean_error", "max_error",
        "low_speed_error", "high_speed_error", "avg_tx_power_dbm",
        "total_energy_joules", "jains_fairness_aoi", "jains_fairness_err"
    ]
    df_summary = df_raw.groupby(["model_name", "category", "density"], as_index=False)[agg_cols].mean()
    # Round summary columns cleanly
    for c in agg_cols:
        if c == "total_energy_joules":
            df_summary[c] = df_summary[c].round(6)
        else:
            df_summary[c] = df_summary[c].round(4)

    # 4. Create overall leaderboard (mean across all densities and seeds)
    df_leaderboard_agg = df_raw.groupby(["model_name", "category"], as_index=False)[agg_cols].mean()

    # Calculate composite score: 1.0 * mean_err + 0.5 * mean_aoi + 2.0 * loss + 0.2 * normalized_power
    p_norm = (df_leaderboard_agg["avg_tx_power_dbm"] - 20.0).clip(lower=0.0) / 10.0
    composite = (
        1.0 * df_leaderboard_agg["mean_error"]
        + 0.5 * df_leaderboard_agg["mean_aoi"]
        + 2.0 * df_leaderboard_agg["packet_loss_rate"]
        + 0.2 * p_norm
    )
    df_leaderboard_agg["composite_score"] = composite.round(4)
    df_leaderboard_sorted = df_leaderboard_agg.sort_values(by="composite_score", ascending=True).reset_index(drop=True)
    df_leaderboard_sorted.insert(0, "rank", range(1, len(df_leaderboard_sorted) + 1))

    for c in agg_cols:
        if c == "total_energy_joules":
            df_leaderboard_sorted[c] = df_leaderboard_sorted[c].round(6)
        else:
            df_leaderboard_sorted[c] = df_leaderboard_sorted[c].round(4)

    # 5. Export to CSV files if output_dir specified
    if output_dir:
        os.makedirs(output_dir, exist_ok=True)
        raw_path = os.path.join(output_dir, "eval_raw_runs.csv")
        summary_path = os.path.join(output_dir, "eval_summary_by_density.csv")
        leaderboard_path = os.path.join(output_dir, "eval_leaderboard.csv")

        df_raw.to_csv(raw_path, index=False)
        df_summary.to_csv(summary_path, index=False)
        df_leaderboard_sorted.to_csv(leaderboard_path, index=False)
        logger.info(f"Exported evaluation datasets:\n  - {raw_path} ({len(df_raw)} rows)\n  - {summary_path} ({len(df_summary)} rows)\n  - {leaderboard_path} ({len(df_leaderboard_sorted)} rows)")

    return df_raw, df_summary, df_leaderboard_sorted


def main() -> None:
    parser = argparse.ArgumentParser(description="AoI-aware V2I Uplink RL Benchmark Evaluation Harness")
    parser.add_argument("--hparams-csv", type=str, default="/home/imnyj/Workspace/paper4/coder/results/hpo/optuna_best_params.csv")
    parser.add_argument("--output-dir", type=str, default="/home/imnyj/Workspace/paper4/coder/results/eval")
    parser.add_argument("--densities", type=float, nargs="+", default=DEFAULT_DENSITIES)
    parser.add_argument("--seeds", type=int, nargs="+", default=DEFAULT_SEEDS)
    parser.add_argument("--n-steps", type=int, default=100)
    parser.add_argument("--models", type=str, nargs="+", default=None)
    args = parser.parse_args()

    df_raw, df_summary, df_leaderboard = run_full_benchmark(
        models=args.models,
        densities=args.densities,
        seeds=args.seeds,
        hparams_csv=args.hparams_csv,
        output_dir=args.output_dir,
        n_steps=args.n_steps,
    )

    print("\n" + "=" * 80)
    print("🏆 IEEE TWC EVALUATION LEADERBOARD (Composite Ranking)")
    print("=" * 80)
    print(df_leaderboard[["rank", "model_name", "category", "mean_aoi", "peak_aoi", "packet_loss_rate", "mean_error", "avg_tx_power_dbm", "composite_score"]].to_string(index=False))
    print("=" * 80 + "\n")


if __name__ == "__main__":
    main()
