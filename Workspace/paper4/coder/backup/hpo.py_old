# src/hpo.py
# ============================================================================
# Hyperparameter Optimization (Optuna HPO) Pipeline for AoI-aware V2I Uplink
#
# Implements Milestone 3 (R3):
# 1. Tailored Optuna search spaces for all 9 baseline algorithms:
#    - Category 1 (Basic 3종): HybridPPO, HybridSAC, HybridTD3
#    - Category 2 (Latest 3종): MAPPO, HyARPPO, MPDQN
#    - Category 3 (SOTA AoI 3종): PureAoI, DuelingQAoI, SACAoI
# 2. Composite objective function balancing:
#    - Position tracking / estimation error integral: mean_error
#    - Average Age of Information: mean_aoi
#    - Uplink outage / packet loss rate: outage_rate
#    - Transmission power consumption: avg_power_norm
# 3. Multi-seed evaluation in the AoI environment with Rayleigh-fading SINR contention.
# 4. CSV export of optimal parameters (`optuna_best_params.csv`) and per-model
#    trial history (`optuna_trials_<model_name>.csv`).
# ============================================================================

from __future__ import annotations
import argparse
import json
import logging
import math
import os
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import optuna
import pandas as pd

from src.baselines import BASELINE_REGISTRY
from src.baselines.base_agent import BaseRLModel
import src.Communications as comm
from src.rl_interface import RetrospectiveReplayBuffer, StateVectorizer

# Setup logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("HPO")

# Canonical 9 baseline model names
CANONICAL_MODEL_NAMES = [
    "HybridPPO",
    "HybridSAC",
    "HybridTD3",
    "MAPPO",
    "HyARPPO",
    "MPDQN",
    "PureAoI",
    "DuelingQAoI",
    "SACAoI",
]

MODEL_CATEGORIES = {
    "HybridPPO": "Category 1 (Basic)",
    "HybridSAC": "Category 1 (Basic)",
    "HybridTD3": "Category 1 (Basic)",
    "MAPPO": "Category 2 (Latest)",
    "HyARPPO": "Category 2 (Latest)",
    "MPDQN": "Category 2 (Latest)",
    "PureAoI": "Category 3 (SOTA AoI)",
    "DuelingQAoI": "Category 3 (SOTA AoI)",
    "SACAoI": "Category 3 (SOTA AoI)",
}


def normalize_model_name(name: str) -> str:
    """Resolve aliases to canonical model name."""
    clean = name.replace("-", "").replace("_", "").lower()
    for canonical in CANONICAL_MODEL_NAMES:
        if clean == canonical.lower():
            return canonical
    if clean in ["hppo", "ppo"]:
        return "HybridPPO"
    if clean in ["hsac", "sac"]:
        return "HybridSAC"
    if clean in ["htd3", "td3"]:
        return "HybridTD3"
    if clean in ["pdqn", "mpdqn"]:
        return "MPDQN"
    if clean in ["pureaoi", "whittle"]:
        return "PureAoI"
    if clean in ["duelingq", "duelingqaoi"]:
        return "DuelingQAoI"
    if clean in ["sacaoi"]:
        return "SACAoI"
    if clean in ["hyarppo", "hyar"]:
        return "HyARPPO"
    return name


def sample_hparams(trial: optuna.Trial, model_name: str) -> Dict[str, Any]:
    """
    Define tailored hyperparameter search space for each of the 9 baseline models.
    """
    canonical_name = normalize_model_name(model_name)
    params: Dict[str, Any] = {}

    if canonical_name == "HybridPPO":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "clip_ratio": trial.suggest_float("clip_ratio", 0.1, 0.3),
            "entropy_coef": trial.suggest_float("entropy_coef", 1e-4, 0.05, log=True),
            "value_coef": trial.suggest_float("value_coef", 0.2, 0.8),
        }
    elif canonical_name == "HybridSAC":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "tau": trial.suggest_float("tau", 0.001, 0.02, log=True),
        }
    elif canonical_name == "HybridTD3":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "tau": trial.suggest_float("tau", 0.001, 0.02, log=True),
            "policy_noise": trial.suggest_float("policy_noise", 0.1, 0.3),
            "noise_clip": trial.suggest_float("noise_clip", 0.2, 0.5),
            "policy_freq": trial.suggest_categorical("policy_freq", [2, 3, 4]),
        }
    elif canonical_name == "MAPPO":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "clip_ratio": trial.suggest_float("clip_ratio", 0.1, 0.3),
            "entropy_coef": trial.suggest_float("entropy_coef", 1e-4, 0.05, log=True),
            "value_coef": trial.suggest_float("value_coef", 0.2, 0.8),
        }
    elif canonical_name == "HyARPPO":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "embed_dim": trial.suggest_categorical("embed_dim", [4, 8, 16]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "clip_ratio": trial.suggest_float("clip_ratio", 0.1, 0.3),
            "entropy_coef": trial.suggest_float("entropy_coef", 1e-4, 0.05, log=True),
            "value_coef": trial.suggest_float("value_coef", 0.2, 0.8),
        }
    elif canonical_name == "MPDQN":
        params = {
            "lr_actor": trial.suggest_float("lr_actor", 1e-4, 3e-3, log=True),
            "lr_critic": trial.suggest_float("lr_critic", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "tau": trial.suggest_float("tau", 0.001, 0.02, log=True),
            "epsilon_initial": trial.suggest_float("epsilon_initial", 0.1, 0.4),
            "epsilon_decay": trial.suggest_float("epsilon_decay", 0.99, 0.999),
        }
    elif canonical_name == "PureAoI":
        params = {
            "urgency_threshold": trial.suggest_float("urgency_threshold", 0.1, 0.7),
        }
    elif canonical_name == "DuelingQAoI":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "tau": trial.suggest_float("tau", 0.001, 0.02, log=True),
            "epsilon_initial": trial.suggest_float("epsilon_initial", 0.1, 0.4),
            "epsilon_decay": trial.suggest_float("epsilon_decay", 0.99, 0.999),
        }
    elif canonical_name == "SACAoI":
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 3e-3, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.95, 0.999),
            "tau": trial.suggest_float("tau", 0.001, 0.02, log=True),
            "lyapunov_v": trial.suggest_float("lyapunov_v", 0.2, 5.0, log=True),
            "aoi_thresh": trial.suggest_float("aoi_thresh", 0.2, 0.6),
        }
    else:
        params = {
            "lr": trial.suggest_float("lr", 1e-4, 1e-2, log=True),
            "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
            "gamma": trial.suggest_float("gamma", 0.90, 0.999),
        }
    return params


def compute_composite_objective(
    metrics: Dict[str, float],
    w_error: float = 1.0,
    w_aoi: float = 0.5,
    w_outage: float = 2.0,
    w_power: float = 0.2,
) -> float:
    """
    Formulates the composite objective function balancing:
    1. Tracking estimation error (m)
    2. Age of Information (s)
    3. Outage rate (packet loss ratio in [0, 1])
    4. Normalized transmission power (in [0, 1] mapped from [20, 30] dBm)
    """
    mean_err = metrics.get("mean_error", 0.0)
    mean_aoi = metrics.get("mean_aoi", 0.0)
    outage_rate = metrics.get("outage_rate", 0.0)
    power_norm = metrics.get("avg_power_norm", 0.5)

    objective_val = (
        w_error * mean_err
        + w_aoi * mean_aoi
        + w_outage * outage_rate
        + w_power * power_norm
    )
    return float(objective_val)


class SyntheticVehicle:
    """Simulated vehicle entity for fast, deterministic HPO environment rollouts."""

    def __init__(
        self,
        vid: str,
        pos: Tuple[float, float],
        vel: Tuple[float, float],
        dist_to_stopline: float,
        tls_state: str,
        time_to_switch: float,
    ) -> None:
        self.vid = vid
        self.pos = list(pos)
        self.vel = list(vel)
        self.accel = 0.0
        self.dist_to_stopline = dist_to_stopline
        self.tls_state = tls_state
        self.time_to_switch = time_to_switch
        self.last_update_t = 0.0
        self.hat_pos = list(pos)
        self.hat_vel = list(vel)
        self.next_tx_t = 0.0
        self.current_ch = 0
        self.current_p = 25.0
        self.is_active = True

    def speed(self) -> float:
        return math.hypot(self.vel[0], self.vel[1])

    def to_state_dict(self, current_time: float, rsu_pos: Tuple[float, float], n_active: int, cbr: float) -> Dict[str, Any]:
        dx = self.pos[0] - rsu_pos[0]
        dy = self.pos[1] - rsu_pos[1]
        dist_rsu = math.hypot(dx, dy)
        spd = self.speed()
        
        stop_imm = 1.0 if (spd > 3.0 and self.tls_state in ["r", "y"] and self.dist_to_stopline < 35.0) else 0.0
        start_imm = 1.0 if (spd < 1.0 and ((self.tls_state == "r" and self.time_to_switch <= 3.0) or (self.tls_state == "g" and self.dist_to_stopline <= 15.0))) else 0.0

        return {
            "vid": self.vid,
            "pos": tuple(self.pos),
            "vel": tuple(self.vel),
            "speed": spd,
            "accel": self.accel,
            "current_time": current_time,
            "last_update_time": self.last_update_t,
            "dist_to_rsu": dist_rsu,
            "n_active": n_active,
            "cbr": cbr,
            "stop_imminent": stop_imm,
            "start_imminent": start_imm,
            "time_to_switch": self.time_to_switch,
            "dist_to_stopline": self.dist_to_stopline,
            "tls_features": {
                "state": self.tls_state,
                "dist_to_stopline": self.dist_to_stopline,
                "time_to_switch": self.time_to_switch,
                "stop_imminent": stop_imm,
                "start_imminent": start_imm,
            },
        }


def evaluate_model_in_env(
    model: BaseRLModel,
    seed: int = 42,
    n_steps: int = 40,
    n_vehicles: int = 16,
    rsu_pos: Tuple[float, float] = (0.0, 0.0),
    rsu_range: float = 800.0,
    train_steps_during_rollout: int = 0,
) -> Dict[str, float]:
    """
    Evaluates a baseline model in the AoI environment for a specific seed.
    Simulates traffic kinematics, TraCI TLS phase transitions, hybrid action scheduling,
    Rayleigh-SINR co-channel contention, retrospective position estimation error, and AoI.
    """
    rng = np.random.RandomState(seed)
    vectorizer = StateVectorizer(rsu_range=rsu_range)
    buffer = RetrospectiveReplayBuffer(capacity=1000) if train_steps_during_rollout > 0 else None

    # Initialize vehicles
    vehicles: List[SyntheticVehicle] = []
    for i in range(n_vehicles):
        angle = rng.uniform(0, 2 * math.pi)
        dist = rng.uniform(50.0, rsu_range * 0.9)
        px = rsu_pos[0] + dist * math.cos(angle)
        py = rsu_pos[1] + dist * math.sin(angle)
        
        # Velocity heading towards or across RSU
        heading = angle + math.pi + rng.uniform(-0.5, 0.5)
        spd = rng.uniform(5.0, 22.0)
        vx = spd * math.cos(heading)
        vy = spd * math.sin(heading)

        dist_stop = rng.uniform(20.0, 400.0)
        tls_state = rng.choice(["g", "g", "r", "y"])
        time_to_switch = rng.uniform(5.0, 35.0)

        v = SyntheticVehicle(
            vid=f"v_{seed}_{i}",
            pos=(px, py),
            vel=(vx, vy),
            dist_to_stopline=dist_stop,
            tls_state=tls_state,
            time_to_switch=time_to_switch,
        )
        vehicles.append(v)

    current_time = 0.0
    dt = 0.5  # simulation step (seconds)

    recorded_errors: List[float] = []
    recorded_aois: List[float] = []
    recorded_powers: List[float] = []
    total_tx_attempts = 0
    total_tx_fails = 0

    for step in range(n_steps):
        current_time += dt
        cbr = min(1.0, float(total_tx_attempts) / max(1.0, float(step + 1) * comm.NUM_SUBCHANNELS * 2.0))

        # Update vehicle kinematics and TLS timers
        for v in vehicles:
            v.time_to_switch = max(0.0, v.time_to_switch - dt)
            if v.time_to_switch <= 0.0:
                if v.tls_state == "g":
                    v.tls_state = "y"
                    v.time_to_switch = 4.0
                elif v.tls_state == "y":
                    v.tls_state = "r"
                    v.time_to_switch = rng.uniform(15.0, 30.0)
                else:
                    v.tls_state = "g"
                    v.time_to_switch = rng.uniform(20.0, 40.0)

            # Move vehicle
            spd = v.speed()
            if v.tls_state == "r" and v.dist_to_stopline < 25.0 and spd > 1.0:
                # Decelerate
                v.accel = -3.0
                new_spd = max(0.0, spd + v.accel * dt)
                factor = new_spd / max(1e-4, spd)
                v.vel[0] *= factor
                v.vel[1] *= factor
            elif v.tls_state == "g" and spd < 15.0:
                # Accelerate
                v.accel = 2.0
                new_spd = min(25.0, spd + v.accel * dt)
                factor = new_spd / max(1e-4, spd)
                v.vel[0] *= factor
                v.vel[1] *= factor
            else:
                v.accel = 0.0

            v.pos[0] += v.vel[0] * dt
            v.pos[1] += v.vel[1] * dt
            v.dist_to_stopline = max(0.0, v.dist_to_stopline - v.speed() * dt)

            # Calculate instantaneous tracking error at RSU
            extrap_x = v.hat_pos[0] + v.hat_vel[0] * (current_time - v.last_update_t)
            extrap_y = v.hat_pos[1] + v.hat_vel[1] * (current_time - v.last_update_t)
            inst_err = math.hypot(v.pos[0] - extrap_x, v.pos[1] - extrap_y)
            recorded_errors.append(inst_err)

            # AoI is elapsed time since last successful update
            aoi = current_time - v.last_update_t
            recorded_aois.append(aoi)

        # Find vehicles ready for transmission
        transmitting_vehicles: List[Tuple[SyntheticVehicle, np.ndarray, np.ndarray, float, int, float]] = []

        for v in vehicles:
            if current_time >= v.next_tx_t:
                st_dict = v.to_state_dict(current_time, rsu_pos, len(vehicles), cbr)
                s_vec = vectorizer.vectorize_from_dict(st_dict, rsu_pos)
                
                # Baseline model action selection
                grant, raw_action, _ = model.select_action(s_vec, deterministic=False)
                delta, ch, p = grant
                
                transmitting_vehicles.append((v, s_vec, raw_action, delta, ch, p))
                recorded_powers.append(p)

        # Resolve uplink transmissions with mutual Rayleigh-SINR contention
        if transmitting_vehicles:
            by_channel: Dict[int, List[Tuple[SyntheticVehicle, float, float]]] = {}
            for v, _, _, _, ch, p in transmitting_vehicles:
                dist_rsu = math.hypot(v.pos[0] - rsu_pos[0], v.pos[1] - rsu_pos[1])
                by_channel.setdefault(ch, []).append((v, p, dist_rsu))

            for ch, group in by_channel.items():
                comm_group = [(item[0].vid, item[1], item[2]) for item in group]
                succ_probs = comm.judge_uplink(comm_group, num_subchannels=comm.NUM_SUBCHANNELS)

                for v, p, dist_rsu in group:
                    total_tx_attempts += 1
                    prob = succ_probs.get(v.vid, 0.0)
                    is_succ = rng.random() < prob

                    if is_succ:
                        # Refresh estimate at RSU
                        v.hat_pos = list(v.pos)
                        v.hat_vel = list(v.vel)
                        v.last_update_t = current_time
                    else:
                        total_tx_fails += 1

            # Update next transmission time
            for v, s_vec, raw_act, delta, ch, p in transmitting_vehicles:
                v.next_tx_t = current_time + delta

                if buffer is not None:
                    # SMDP transition buffer storage for warm-up training
                    st_next_dict = v.to_state_dict(current_time + delta, rsu_pos, len(vehicles), cbr)
                    s_next_vec = vectorizer.vectorize_from_dict(st_next_dict, rsu_pos)
                    reward = -(delta * 0.3 + (p - 20.0) * 0.02)
                    buffer.push(s_vec, raw_act, reward, s_next_vec, done=False, delta_t=delta)

        # Execute training updates if requested
        if buffer is not None and len(buffer) >= 16 and train_steps_during_rollout > 0:
            for _ in range(train_steps_during_rollout):
                batch = buffer.sample(batch_size=16)
                try:
                    model.update(batch)
                except Exception:
                    pass

    # Aggregate metrics
    mean_err = float(np.mean(recorded_errors)) if recorded_errors else 0.0
    mean_aoi = float(np.mean(recorded_aois)) if recorded_aois else 0.0
    outage_rate = float(total_tx_fails / max(1, total_tx_attempts))
    avg_p = float(np.mean(recorded_powers)) if recorded_powers else 25.0
    avg_p_norm = float(np.clip((avg_p - 20.0) / 10.0, 0.0, 1.0))

    return {
        "mean_error": round(mean_err, 4),
        "mean_aoi": round(mean_aoi, 4),
        "outage_rate": round(outage_rate, 4),
        "avg_power_dbm": round(avg_p, 4),
        "avg_power_norm": round(avg_p_norm, 4),
        "tx_attempts": total_tx_attempts,
        "tx_fails": total_tx_fails,
    }


def evaluate_trial_multiseed(
    model_cls: Any,
    hparams: Dict[str, Any],
    seeds: List[int],
    n_steps: int = 35,
    n_vehicles: int = 15,
) -> Tuple[float, Dict[str, float]]:
    """
    Evaluates a set of hyperparameters across multiple seeds and returns the mean composite score.
    """
    scores = []
    seed_metrics: List[Dict[str, float]] = []

    for seed in seeds:
        try:
            # Instantiate model
            model = model_cls(state_dim=16, num_channels=comm.NUM_SUBCHANNELS, **hparams)
            metrics = evaluate_model_in_env(
                model=model,
                seed=seed,
                n_steps=n_steps,
                n_vehicles=n_vehicles,
                train_steps_during_rollout=2,
            )
            score = compute_composite_objective(metrics)
            scores.append(score)
            seed_metrics.append(metrics)
        except Exception as e:
            logger.warning(f"Error during rollout for seed {seed}: {e}")
            scores.append(100.0)

    mean_score = float(np.mean(scores)) if scores else 100.0
    
    # Average individual metrics across seeds
    avg_metrics: Dict[str, float] = {}
    if seed_metrics:
        for k in ["mean_error", "mean_aoi", "outage_rate", "avg_power_dbm", "avg_power_norm"]:
            avg_metrics[k] = round(float(np.mean([m.get(k, 0.0) for m in seed_metrics])), 4)

    return mean_score, avg_metrics


def run_hpo_study(
    model_name: str,
    n_trials: int = 15,
    seeds: Optional[List[int]] = None,
    storage: Optional[str] = None,
    study_name: Optional[str] = None,
    n_steps: int = 35,
    sampler: Optional[optuna.samplers.BaseSampler] = None,
    pruner: Optional[optuna.pruners.BasePruner] = None,
) -> optuna.Study:
    """
    Runs an Optuna study to optimize hyperparameters for a given baseline model.
    """
    canonical_name = normalize_model_name(model_name)
    if canonical_name not in BASELINE_REGISTRY:
        raise ValueError(f"Unknown baseline model: '{model_name}'. Must be one of {CANONICAL_MODEL_NAMES}")

    model_cls = BASELINE_REGISTRY[canonical_name]
    eval_seeds = seeds if seeds is not None else [42, 101, 2024]
    
    if sampler is None:
        sampler = optuna.samplers.TPESampler(seed=42)
    if pruner is None:
        pruner = optuna.pruners.MedianPruner(n_startup_trials=3, n_warmup_steps=1)

    optuna.logging.set_verbosity(optuna.logging.WARNING)

    study = optuna.create_study(
        study_name=study_name or f"hpo_{canonical_name}",
        direction="minimize",
        storage=storage,
        sampler=sampler,
        pruner=pruner,
        load_if_exists=True,
    )

    def objective(trial: optuna.Trial) -> float:
        hparams = sample_hparams(trial, canonical_name)
        score, avg_metrics = evaluate_trial_multiseed(
            model_cls=model_cls,
            hparams=hparams,
            seeds=eval_seeds,
            n_steps=n_steps,
        )
        for k, v in avg_metrics.items():
            trial.set_user_attr(k, v)
        trial.set_user_attr("composite_score", score)
        return score

    study.optimize(objective, n_trials=n_trials, n_jobs=1)
    logger.info(
        f"[{canonical_name}] HPO Complete! Best Trial #{study.best_trial.number}: "
        f"Value={study.best_value:.4f}, Params={study.best_params}"
    )
    return study


def save_study_results(
    study: optuna.Study,
    model_name: str,
    output_dir: str = "/home/imnyj/Workspace/paper4/coder/results/hpo",
) -> Tuple[str, Dict[str, Any]]:
    """
    Saves Optuna study trial history to CSV.
    """
    os.makedirs(output_dir, exist_ok=True)
    canonical_name = normalize_model_name(model_name)
    
    trials_csv_path = os.path.join(output_dir, f"optuna_trials_{canonical_name}.csv")
    df_trials = study.trials_dataframe()
    df_trials.to_csv(trials_csv_path, index=False)
    
    best_record = {
        "model_name": canonical_name,
        "category": MODEL_CATEGORIES.get(canonical_name, "Baseline"),
        "best_value": round(float(study.best_value), 4),
        "best_trial_number": int(study.best_trial.number),
        "best_params": study.best_params,
    }
    return trials_csv_path, best_record


def run_all_baselines_hpo(
    n_trials: int = 15,
    output_dir: str = "/home/imnyj/Workspace/paper4/coder/results/hpo",
    models: Optional[List[str]] = None,
    seeds: Optional[List[int]] = None,
    n_steps: int = 35,
) -> Tuple[str, pd.DataFrame]:
    """
    Runs hyperparameter optimization across all baseline models, generates per-model trial CSVs,
    and consolidates the optimal hyperparameters into optuna_best_params.csv.
    """
    os.makedirs(output_dir, exist_ok=True)
    target_models = [normalize_model_name(m) for m in (models or CANONICAL_MODEL_NAMES)]
    eval_seeds = seeds or [42, 101, 2024]

    best_records: List[Dict[str, Any]] = []

    for model_name in target_models:
        logger.info(f"===> Starting Optuna HPO for baseline: {model_name} (trials={n_trials})")
        study = run_hpo_study(
            model_name=model_name,
            n_trials=n_trials,
            seeds=eval_seeds,
            n_steps=n_steps,
        )
        _, record = save_study_results(study, model_name=model_name, output_dir=output_dir)
        
        # Flatten record for master CSV
        flat_row: Dict[str, Any] = {
            "model_name": record["model_name"],
            "category": record["category"],
            "best_value": record["best_value"],
            "best_trial_number": record["best_trial_number"],
        }
        for k, v in record["best_params"].items():
            flat_row[k] = v
        flat_row["hparams_json"] = json.dumps(record["best_params"])
        best_records.append(flat_row)

    df_best = pd.DataFrame(best_records)
    best_csv_path = os.path.join(output_dir, "optuna_best_params.csv")
    df_best.to_csv(best_csv_path, index=False)
    logger.info(f"All baselines HPO complete! Master parameters saved to {best_csv_path}")

    return best_csv_path, df_best


def main() -> None:
    parser = argparse.ArgumentParser(description="Optuna HPO Pipeline for AoI Baseline Models")
    parser.add_argument("--n-trials", type=int, default=15, help="Number of trials per model")
    parser.add_argument("--output-dir", type=str, default="/home/imnyj/Workspace/paper4/coder/results/hpo")
    parser.add_argument("--models", nargs="+", default=CANONICAL_MODEL_NAMES, help="List of models to optimize")
    parser.add_argument("--seeds", nargs="+", type=int, default=[42, 101, 2024], help="Evaluation seeds")
    parser.add_argument("--n-steps", type=int, default=35, help="Simulation steps per seed")
    args = parser.parse_args()

    run_all_baselines_hpo(
        n_trials=args.n_trials,
        output_dir=args.output_dir,
        models=args.models,
        seeds=args.seeds,
        n_steps=args.n_steps,
    )


if __name__ == "__main__":
    main()
